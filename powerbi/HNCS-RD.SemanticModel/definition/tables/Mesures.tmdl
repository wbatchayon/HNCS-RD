	measure Cible = SELECTEDVALUE ( Objectifs[Cible] )
		formatString: #,##0.##
		displayFolder: Objectifs
		lineageTag: e34bcdd0-d68e-5757-b4ad-7bbce5d66453

	measure 'Dernière actualisation' = MAX ( Mesures[DerniereActualisation] )
		formatString: dd/MM/yyyy HH:mm
		displayFolder: Technique
		lineageTag: 573c2232-f62d-57f3-af88-88f5052cd6c4

	column DerniereActualisation
		dataType: dateTime
		isHidden
		formatString: dd/MM/yyyy HH:mm
		lineageTag: 807dd53b-2625-57c6-99e6-df930c29e28e
		summarizeBy: none
		sourceColumn: DerniereActualisation

		annotation SummarizationSetBy = Automatic

	partition Mesures = m
		mode: import
		source =
				let
					// Table de mesures : une seule ligne portant l'horodatage de l'actualisation (heure de Paris).
					Source = #table(type table [DerniereActualisation = datetime], {{fnHeureParis(DateTimeZone.FixedUtcNow())}})
				in
					Source

	annotation PBI_ResultType = Table

