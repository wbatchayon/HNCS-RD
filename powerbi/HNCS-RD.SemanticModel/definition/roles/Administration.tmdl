role Administration
	modelPermission: read

	tablePermission Candidatures = NOT ISBLANK ( Candidatures[DateTransmissionAdmin] )

	tablePermission Livrables = FALSE ()

	tablePermission ComptesRendus = FALSE ()

	tablePermission Mobilisations = FALSE ()

	tablePermission GitlabSync = FALSE ()

	annotation HNCS_Membres = Équipe administrative (affectation dans le service Power BI, H-16)

