{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hncs_outlook"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hncs_sharepoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "hncs_SiteUrl (hncs_SiteUrl)": {
          "defaultValue": "https://contoso.sharepoint.com/sites/HNCS-RD",
          "type": "String",
          "metadata": {
            "schemaName": "hncs_SiteUrl",
            "description": "URL du site SharePoint HNCS-R&D (sans barre finale)"
          }
        },
        "hncs_SupportEmail (hncs_SupportEmail)": {
          "defaultValue": "support-rd@contoso.com",
          "type": "String",
          "metadata": {
            "schemaName": "hncs_SupportEmail",
            "description": "Adresse du support des flux (N-99, N-98)"
          }
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "schedule": {
              "hours": [
                "7"
              ],
              "minutes": [
                30
              ]
            },
            "timeZone": "Romance Standard Time"
          }
        }
      },
      "actions": {
        "Principal": {
          "type": "Scope",
          "actions": {
            "Lire_parametres": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Paramètres",
                  "$filter": "Categorie eq 'Destinataires' or Categorie eq 'Délais' or Categorie eq 'Fonctionnalités' or Categorie eq 'Conservation' or Categorie eq 'Liens' or Categorie eq 'Gouvernance' or Categorie eq 'Canaux'",
                  "$top": 500
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {}
            },
            "Parametres_cles_valeurs": {
              "type": "Select",
              "inputs": {
                "from": "@body('Lire_parametres')?['value']",
                "select": "@concat('\"', replace(item()?['Title'], '\"', ''), '\":', if(empty(item()?['Valeur']), 'null', concat('\"', replace(replace(item()?['Valeur'], '\\', '\\\\'), '\"', '\\\"'), '\"')))"
              },
              "runAfter": {
                "Lire_parametres": [
                  "Succeeded"
                ]
              }
            },
            "Parametres": {
              "type": "Compose",
              "inputs": "@json(concat('{', join(body('Parametres_cles_valeurs'), ','), '}'))",
              "runAfter": {
                "Parametres_cles_valeurs": [
                  "Succeeded"
                ]
              }
            },
            "Aujourdhui": {
              "type": "Compose",
              "inputs": "@formatDateTime(convertTimeZone(utcNow(), 'UTC', 'Romance Standard Time'), 'yyyy-MM-dd')",
              "runAfter": {
                "Parametres": [
                  "Succeeded"
                ]
              }
            },
            "Membres_G_PROP": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/sitegroups/getbyname('HNCS-RD-Proprietaires')/users?$select=Email",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Aujourdhui": [
                  "Succeeded"
                ]
              }
            },
            "Emails_G_PROP": {
              "type": "Select",
              "inputs": {
                "from": "@body('Membres_G_PROP')?['value']",
                "select": "@toLower(coalesce(item()?['Email'], ''))"
              },
              "runAfter": {
                "Membres_G_PROP": [
                  "Succeeded"
                ]
              }
            },
            "Erreurs_a_reprendre": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Journal des flux",
                  "$filter": "Niveau eq 'Erreur' and StatutReprise eq 'À reprendre'",
                  "$orderby": "DateEvenement desc",
                  "$top": 5000
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Emails_G_PROP": [
                  "Succeeded"
                ]
              }
            },
            "Tableau_erreurs": {
              "type": "Table",
              "inputs": {
                "from": "@body('Erreurs_a_reprendre')?['value']",
                "format": "HTML",
                "columns": [
                  {
                    "header": "Date",
                    "value": "@if(empty(item()?['DateEvenement']), '', formatDateTime(convertTimeZone(item()?['DateEvenement'], 'UTC', 'Romance Standard Time'), 'dd/MM/yyyy HH:mm'))"
                  },
                  {
                    "header": "Flux",
                    "value": "@item()?['Title']"
                  },
                  {
                    "header": "Objet",
                    "value": "@coalesce(item()?['IdObjet'], '')"
                  },
                  {
                    "header": "Message",
                    "value": "@item()?['Message']"
                  },
                  {
                    "header": "Exécution",
                    "value": "@coalesce(item()?['RunUrl'], '')"
                  }
                ]
              },
              "runAfter": {
                "Erreurs_a_reprendre": [
                  "Succeeded"
                ]
              }
            },
            "Si_erreurs": {
              "type": "If",
              "expression": "@greater(length(body('Erreurs_a_reprendre')?['value']), 0)",
              "actions": {
                "Dest_N98": {
                  "type": "Select",
                  "inputs": {
                    "from": "@split(concat(coalesce(parameters('hncs_SupportEmail (hncs_SupportEmail)'), ''), ';', coalesce(join(body('Emails_G_PROP'), ';'), '')), ';')",
                    "select": "@toLower(trim(item()))"
                  },
                  "runAfter": {}
                },
                "DestOK_N98": {
                  "type": "Query",
                  "inputs": {
                    "from": "@body('Dest_N98')",
                    "where": "@not(empty(item()))"
                  },
                  "runAfter": {
                    "Dest_N98": [
                      "Succeeded"
                    ]
                  }
                },
                "Si_destinataires_N98": {
                  "type": "If",
                  "expression": "@greater(length(body('DestOK_N98')), 0)",
                  "actions": {
                    "Envoyer_N98": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "connectionName": "shared_office365",
                          "operationId": "SharedMailboxSendEmailV2"
                        },
                        "parameters": {
                          "body/MailboxAddress": "@{coalesce(outputs('Parametres')?['Destinataires.BoiteRD'], '')}",
                          "body/To": "@{join(union(body('DestOK_N98'), body('DestOK_N98')), ';')}",
                          "body/Subject": "[HNCS-R&D][N-98] Erreurs de flux à reprendre (@{string(length(body('Erreurs_a_reprendre')?['value']))})",
                          "body/Body": "<html>\n<head><meta charset=\"utf-8\"><title>[HNCS-R&amp;D][N-98] Erreurs de flux à reprendre (@{string(length(body('Erreurs_a_reprendre')?['value']))})</title></head>\n<body style=\"font-family:'Segoe UI',Arial,sans-serif;font-size:14px;color:#222222\">\n<p>Bonjour,</p>\n<p>@{string(length(body('Erreurs_a_reprendre')?['value']))} erreur(s) de flux restent à reprendre :</p>\n@{body('Tableau_erreurs')}\n<p>Procédure : corriger la cause, « Resoumettre » l'exécution depuis son lien, puis passer « Statut de reprise » à « Reprise effectuée ».</p>\n<p><a href=\"@{concat(parameters('hncs_SiteUrl (hncs_SiteUrl)'), '/Lists/JournalFlux')}\">Ouvrir le journal des flux</a></p>\n<p style=\"color:#666666;font-size:12px\">Message automatique du système de suivi R&amp;D HNCS — ne pas répondre. Aucune pièce jointe n'est jamais transmise : les documents sont accessibles par lien, selon vos droits.</p>\n</body>\n</html>",
                          "body/Importance": "Normal"
                        },
                        "authentication": "@parameters('$authentication')",
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 4,
                          "interval": "PT10S"
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {
                      "Sans_destinataire_N98": {
                        "type": "Workflow",
                        "inputs": {
                          "host": {
                            "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                          },
                          "body": {
                            "CodeFlux": "PA-00E",
                            "Niveau": "Avertissement",
                            "Liste": "",
                            "ItemId": "@{string(coalesce('', ''))}",
                            "IdObjet": "@{coalesce('', '')}",
                            "Message": "@{'N-98 : aucun destinataire résolu, notification non envoyée'}",
                            "DetailErreur": "@{string(coalesce('', ''))}",
                            "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                          }
                        },
                        "runAfter": {}
                      }
                    }
                  },
                  "runAfter": {
                    "DestOK_N98": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Tableau_erreurs": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Erreur": {
          "type": "Scope",
          "actions": {
            "Detail_erreur": {
              "type": "Compose",
              "inputs": "@string(result('Principal'))",
              "runAfter": {}
            },
            "Journaliser_erreur": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                },
                "body": {
                  "CodeFlux": "PA-00E",
                  "Niveau": "Erreur",
                  "Liste": "",
                  "ItemId": "@{string(coalesce('', ''))}",
                  "IdObjet": "@{coalesce('', '')}",
                  "Message": "@{'Échec de l''exécution du flux PA-00E'}",
                  "DetailErreur": "@{string(coalesce(substring(outputs('Detail_erreur'), 0, min(length(outputs('Detail_erreur')), 8000)), ''))}",
                  "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                }
              },
              "runAfter": {
                "Detail_erreur": [
                  "Succeeded"
                ]
              }
            },
            "Terminer_en_echec": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "HNCS_ECHEC",
                  "message": "Échec du flux PA-00E : voir le journal des flux"
                }
              },
              "runAfter": {
                "Journaliser_erreur": [
                  "Succeeded",
                  "Failed",
                  "TimedOut",
                  "Skipped"
                ]
              }
            }
          },
          "runAfter": {
            "Principal": [
              "Failed",
              "TimedOut"
            ]
          }
        },
        "Terminer": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Succeeded"
          },
          "runAfter": {
            "Erreur": [
              "Skipped"
            ]
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
