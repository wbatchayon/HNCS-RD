{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hncs_outlook"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hncs_sharepoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "hncs_SiteUrl (hncs_SiteUrl)": {
          "defaultValue": "https://contoso.sharepoint.com/sites/HNCS-RD",
          "type": "String",
          "metadata": {
            "schemaName": "hncs_SiteUrl",
            "description": "URL du site SharePoint HNCS-R&D (sans barre finale)"
          }
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Month",
            "interval": 1,
            "startTime": "2026-11-01T06:00:00",
            "timeZone": "Romance Standard Time"
          }
        }
      },
      "actions": {
        "Principal": {
          "type": "Scope",
          "actions": {
            "Lire_parametres": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Paramètres",
                  "$filter": "Categorie eq 'Destinataires' or Categorie eq 'Délais' or Categorie eq 'Fonctionnalités' or Categorie eq 'Conservation' or Categorie eq 'Liens' or Categorie eq 'Gouvernance' or Categorie eq 'Canaux'",
                  "$top": 500
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {}
            },
            "Parametres_cles_valeurs": {
              "type": "Select",
              "inputs": {
                "from": "@body('Lire_parametres')?['value']",
                "select": "@concat('\"', replace(item()?['Title'], '\"', ''), '\":', if(empty(item()?['Valeur']), 'null', concat('\"', replace(replace(item()?['Valeur'], '\\', '\\\\'), '\"', '\\\"'), '\"')))"
              },
              "runAfter": {
                "Lire_parametres": [
                  "Succeeded"
                ]
              }
            },
            "Parametres": {
              "type": "Compose",
              "inputs": "@json(concat('{', join(body('Parametres_cles_valeurs'), ','), '}'))",
              "runAfter": {
                "Parametres_cles_valeurs": [
                  "Succeeded"
                ]
              }
            },
            "Aujourdhui": {
              "type": "Compose",
              "inputs": "@formatDateTime(convertTimeZone(utcNow(), 'UTC', 'Romance Standard Time'), 'yyyy-MM-dd')",
              "runAfter": {
                "Parametres": [
                  "Succeeded"
                ]
              }
            },
            "Membres_G_DRD": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/sitegroups/getbyname('HNCS-RD-DirectionRD')/users?$select=Email",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Aujourdhui": [
                  "Succeeded"
                ]
              }
            },
            "Membres_G_PROP": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/sitegroups/getbyname('HNCS-RD-Proprietaires')/users?$select=Email",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Membres_G_DRD": [
                  "Succeeded"
                ]
              }
            },
            "Emails_G_DRD": {
              "type": "Select",
              "inputs": {
                "from": "@body('Membres_G_DRD')?['value']",
                "select": "@toLower(coalesce(item()?['Email'], ''))"
              },
              "runAfter": {
                "Membres_G_PROP": [
                  "Succeeded"
                ]
              }
            },
            "Emails_G_PROP": {
              "type": "Select",
              "inputs": {
                "from": "@body('Membres_G_PROP')?['value']",
                "select": "@toLower(coalesce(item()?['Email'], ''))"
              },
              "runAfter": {
                "Emails_G_DRD": [
                  "Succeeded"
                ]
              }
            },
            "Si_duree_non_validee": {
              "type": "If",
              "expression": "@empty(coalesce(outputs('Parametres')?['Conservation.CandidatureNonRetenueMois'], ''))",
              "actions": {
                "Fin_conservation_inactive": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Succeeded"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Emails_G_PROP": [
                  "Succeeded"
                ]
              }
            },
            "Si_mode_non_implemente": {
              "type": "If",
              "expression": "@not(equals(coalesce(outputs('Parametres')?['Conservation.ModePurge'], 'Signalement'), 'Signalement'))",
              "actions": {
                "Mode_purge_ignore": {
                  "type": "Workflow",
                  "inputs": {
                    "host": {
                      "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                    },
                    "body": {
                      "CodeFlux": "PA-13",
                      "Niveau": "Avertissement",
                      "Liste": "",
                      "ItemId": "@{string(coalesce('', ''))}",
                      "IdObjet": "@{coalesce('', '')}",
                      "Message": "@{'Conservation.ModePurge ≠ Signalement : seul le signalement est implémenté'}",
                      "DetailErreur": "@{string(coalesce('', ''))}",
                      "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Si_duree_non_validee": [
                  "Succeeded"
                ]
              }
            },
            "Candidatures_closes": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Candidatures",
                  "$filter": "(Statut eq 'Non retenue' or Statut eq 'Clôturée') and DateCloture ne null",
                  "$top": 5000
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Si_mode_non_implemente": [
                  "Succeeded"
                ]
              }
            },
            "Pour_candidature": {
              "type": "Foreach",
              "foreach": "@body('Candidatures_closes')?['value']",
              "actions": {
                "Si_date_a_jour": {
                  "type": "If",
                  "expression": "@not(equals(if(empty(items('Pour_candidature')?['DateFinConservation']), '', formatDateTime(convertTimeZone(items('Pour_candidature')?['DateFinConservation'], 'UTC', 'Romance Standard Time'), 'yyyy-MM-dd')), formatDateTime(addToTime(items('Pour_candidature')?['DateCloture'], int(coalesce(outputs('Parametres')?['Conservation.CandidatureNonRetenueMois'], '')), 'Month'), 'yyyy-MM-dd')))",
                  "actions": {
                    "DateFinConservation": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PatchItem"
                        },
                        "parameters": {
                          "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                          "table": "Candidatures",
                          "id": "@items('Pour_candidature')?['ID']",
                          "item/DateFinConservation": "@{formatDateTime(addToTime(items('Pour_candidature')?['DateCloture'], int(coalesce(outputs('Parametres')?['Conservation.CandidatureNonRetenueMois'], '')), 'Month'), 'yyyy-MM-dd')}",
                          "item/Canal/Value": "@{items('Pour_candidature')?['Canal']?['Value']}",
                          "item/ModeReception/Value": "@{items('Pour_candidature')?['ModeReception']?['Value']}",
                          "item/DateReception": "@items('Pour_candidature')?['DateReception']",
                          "item/Statut/Value": "@{items('Pour_candidature')?['Statut']?['Value']}",
                          "item/Title": "@items('Pour_candidature')?['Title']"
                        },
                        "authentication": "@parameters('$authentication')",
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 4,
                          "interval": "PT10S"
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {}
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "runAfter": {
                "Candidatures_closes": [
                  "Succeeded"
                ]
              }
            },
            "Conservation_depassee": {
              "type": "Query",
              "inputs": {
                "from": "@body('Candidatures_closes')?['value']",
                "where": "@less(formatDateTime(addToTime(item()?['DateCloture'], int(coalesce(outputs('Parametres')?['Conservation.CandidatureNonRetenueMois'], '')), 'Month'), 'yyyy-MM-dd'), outputs('Aujourdhui'))"
              },
              "runAfter": {
                "Pour_candidature": [
                  "Succeeded"
                ]
              }
            },
            "Identifiants": {
              "type": "Select",
              "inputs": {
                "from": "@body('Conservation_depassee')",
                "select": "@coalesce(item()?['IdHNCS'], string(item()?['ID']))"
              },
              "runAfter": {
                "Conservation_depassee": [
                  "Succeeded"
                ]
              }
            },
            "Si_candidatures_a_traiter": {
              "type": "If",
              "expression": "@greater(length(body('Identifiants')), 0)",
              "actions": {
                "Dest_N46": {
                  "type": "Select",
                  "inputs": {
                    "from": "@split(concat(coalesce(join(body('Emails_G_DRD'), ';'), ''), ';', coalesce(join(body('Emails_G_PROP'), ';'), '')), ';')",
                    "select": "@toLower(trim(item()))"
                  },
                  "runAfter": {}
                },
                "DestOK_N46": {
                  "type": "Query",
                  "inputs": {
                    "from": "@body('Dest_N46')",
                    "where": "@not(empty(item()))"
                  },
                  "runAfter": {
                    "Dest_N46": [
                      "Succeeded"
                    ]
                  }
                },
                "Si_destinataires_N46": {
                  "type": "If",
                  "expression": "@greater(length(body('DestOK_N46')), 0)",
                  "actions": {
                    "Envoyer_N46": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "connectionName": "shared_office365",
                          "operationId": "SharedMailboxSendEmailV2"
                        },
                        "parameters": {
                          "body/MailboxAddress": "@{coalesce(outputs('Parametres')?['Destinataires.BoiteRD'], '')}",
                          "body/To": "@{join(union(body('DestOK_N46'), body('DestOK_N46')), ';')}",
                          "body/Subject": "[HNCS-R&D][N-46] Candidatures arrivées en fin de conservation",
                          "body/Body": "<html>\n<head><meta charset=\"utf-8\"><title>[HNCS-R&amp;D][N-46] Candidatures arrivées en fin de conservation</title></head>\n<body style=\"font-family:'Segoe UI',Arial,sans-serif;font-size:14px;color:#222222\">\n<p>Bonjour,</p>\n<p>@{string(length(body('Identifiants')))} candidature(s) ont dépassé leur date de fin de conservation :</p>\n<p>@{join(body('Identifiants'), ', ')}</p>\n<p>Mode « Signalement » : aucune suppression automatique. Procédure : vérifier chaque dossier, puis traiter manuellement (suppression ou anonymisation) selon la règle validée par le DPO, et tracer l'opération.</p>\n<p><a href=\"@{concat(parameters('hncs_SiteUrl (hncs_SiteUrl)'), '/Lists/Candidatures')}\">Ouvrir la liste des candidatures</a></p>\n<p style=\"color:#666666;font-size:12px\">Message automatique du système de suivi R&amp;D HNCS — ne pas répondre. Aucune pièce jointe n'est jamais transmise : les documents sont accessibles par lien, selon vos droits.</p>\n</body>\n</html>",
                          "body/Importance": "Normal"
                        },
                        "authentication": "@parameters('$authentication')",
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 4,
                          "interval": "PT10S"
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {
                      "Sans_destinataire_N46": {
                        "type": "Workflow",
                        "inputs": {
                          "host": {
                            "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                          },
                          "body": {
                            "CodeFlux": "PA-13",
                            "Niveau": "Avertissement",
                            "Liste": "",
                            "ItemId": "@{string(coalesce('', ''))}",
                            "IdObjet": "@{coalesce('', '')}",
                            "Message": "@{'N-46 : aucun destinataire résolu, notification non envoyée'}",
                            "DetailErreur": "@{string(coalesce('', ''))}",
                            "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                          }
                        },
                        "runAfter": {}
                      }
                    }
                  },
                  "runAfter": {
                    "DestOK_N46": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Identifiants": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Erreur": {
          "type": "Scope",
          "actions": {
            "Detail_erreur": {
              "type": "Compose",
              "inputs": "@string(result('Principal'))",
              "runAfter": {}
            },
            "Journaliser_erreur": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                },
                "body": {
                  "CodeFlux": "PA-13",
                  "Niveau": "Erreur",
                  "Liste": "",
                  "ItemId": "@{string(coalesce('', ''))}",
                  "IdObjet": "@{coalesce('', '')}",
                  "Message": "@{'Échec de l''exécution du flux PA-13'}",
                  "DetailErreur": "@{string(coalesce(substring(outputs('Detail_erreur'), 0, min(length(outputs('Detail_erreur')), 8000)), ''))}",
                  "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                }
              },
              "runAfter": {
                "Detail_erreur": [
                  "Succeeded"
                ]
              }
            },
            "Terminer_en_echec": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "HNCS_ECHEC",
                  "message": "Échec du flux PA-13 : voir le journal des flux"
                }
              },
              "runAfter": {
                "Journaliser_erreur": [
                  "Succeeded",
                  "Failed",
                  "TimedOut",
                  "Skipped"
                ]
              }
            }
          },
          "runAfter": {
            "Principal": [
              "Failed",
              "TimedOut"
            ]
          }
        },
        "Terminer": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Succeeded"
          },
          "runAfter": {
            "Erreur": [
              "Skipped"
            ]
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
