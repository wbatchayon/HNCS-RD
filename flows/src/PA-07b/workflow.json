{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hncs_outlook"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hncs_sharepoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_teams": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hncs_teams"
        },
        "api": {
          "name": "shared_teams"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "hncs_SiteUrl (hncs_SiteUrl)": {
          "defaultValue": "https://contoso.sharepoint.com/sites/HNCS-RD",
          "type": "String",
          "metadata": {
            "schemaName": "hncs_SiteUrl",
            "description": "URL du site SharePoint HNCS-R&D (sans barre finale)"
          }
        },
        "hncs_ServiceAccountEmail (hncs_ServiceAccountEmail)": {
          "defaultValue": "svc-hncs-rd@contoso.com",
          "type": "String",
          "metadata": {
            "schemaName": "hncs_ServiceAccountEmail",
            "description": "Adresse du compte de service des flux (rôle FLUX)"
          }
        }
      },
      "triggers": {
        "Quand_un_fichier_est_cree_ou_modifie": {
          "type": "OpenApiConnection",
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnUpdatedFileItems"
            },
            "parameters": {
              "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
              "table": "04 - Livrables R&D"
            },
            "authentication": "@parameters('$authentication')"
          },
          "conditions": [
            {
              "expression": "@not(equals(toLower(triggerOutputs()?['body/Editor/Email']), toLower(parameters('hncs_ServiceAccountEmail (hncs_ServiceAccountEmail)'))))"
            },
            {
              "expression": "@not(empty(triggerOutputs()?['body/Livrable/Id']))"
            }
          ]
        }
      },
      "actions": {
        "Principal": {
          "type": "Scope",
          "actions": {
            "Lire_parametres": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Paramètres",
                  "$filter": "Categorie eq 'Destinataires' or Categorie eq 'Délais' or Categorie eq 'Fonctionnalités' or Categorie eq 'Conservation' or Categorie eq 'Liens' or Categorie eq 'Gouvernance' or Categorie eq 'Canaux'",
                  "$top": 500
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {}
            },
            "Parametres_cles_valeurs": {
              "type": "Select",
              "inputs": {
                "from": "@body('Lire_parametres')?['value']",
                "select": "@concat('\"', replace(item()?['Title'], '\"', ''), '\":', if(empty(item()?['Valeur']), 'null', concat('\"', replace(replace(item()?['Valeur'], '\\', '\\\\'), '\"', '\\\"'), '\"')))"
              },
              "runAfter": {
                "Lire_parametres": [
                  "Succeeded"
                ]
              }
            },
            "Parametres": {
              "type": "Compose",
              "inputs": "@json(concat('{', join(body('Parametres_cles_valeurs'), ','), '}'))",
              "runAfter": {
                "Parametres_cles_valeurs": [
                  "Succeeded"
                ]
              }
            },
            "Aujourdhui": {
              "type": "Compose",
              "inputs": "@formatDateTime(convertTimeZone(utcNow(), 'UTC', 'Romance Standard Time'), 'yyyy-MM-dd')",
              "runAfter": {
                "Parametres": [
                  "Succeeded"
                ]
              }
            },
            "Versions_element": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "@{concat('_api/web/GetList(''', concat(uriPath(parameters('hncs_SiteUrl (hncs_SiteUrl)')), '/LivrablesRD'), ''')/items(', string(triggerOutputs()?['body/ID']), ')/versions?$orderby=VersionId desc&$top=2')}",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Aujourdhui": [
                  "Succeeded"
                ]
              }
            },
            "Si_modification_humaine_a_verifier": {
              "type": "If",
              "expression": "@and(greater(length(coalesce(body('Versions_element')?['value'], createArray())), 1), not(equals(toLower(coalesce(first(body('Versions_element')?['value'])?['Editor']?['Email'], '')), toLower(parameters('hncs_ServiceAccountEmail (hncs_ServiceAccountEmail)')))))",
              "actions": {
                "Modifications_depuis_version_precedente": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "GetItemChanges"
                    },
                    "parameters": {
                      "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                      "table": "04 - Livrables R&D",
                      "id": "@triggerOutputs()?['body/ID']",
                      "since": "@{string(body('Versions_element')?['value']?[1]?['VersionLabel'])}",
                      "includeDrafts": false
                    },
                    "authentication": "@parameters('$authentication')",
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 4,
                      "interval": "PT10S"
                    }
                  },
                  "runAfter": {}
                },
                "Colonnes_techniques_modifiees": {
                  "type": "Query",
                  "inputs": {
                    "from": "@createArray('IdObjet')",
                    "where": "@equals(string(coalesce(body('Modifications_depuis_version_precedente')?['ColumnHasChanged']?[item()], false)), 'True')"
                  },
                  "runAfter": {
                    "Modifications_depuis_version_precedente": [
                      "Succeeded"
                    ]
                  }
                },
                "Si_colonne_technique_modifiee": {
                  "type": "If",
                  "expression": "@greater(length(body('Colonnes_techniques_modifiees')), 0)",
                  "actions": {
                    "Type_entite_colonnes_techniques": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "HttpRequest"
                        },
                        "parameters": {
                          "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                          "parameters/method": "GET",
                          "parameters/uri": "@{concat('_api/web/GetList(''', concat(uriPath(parameters('hncs_SiteUrl (hncs_SiteUrl)')), '/LivrablesRD'), ''')?$select=ListItemEntityTypeFullName')}",
                          "parameters/headers": {
                            "Accept": "application/json;odata=nometadata",
                            "Content-Type": "application/json;odata=nometadata"
                          }
                        },
                        "authentication": "@parameters('$authentication')",
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 4,
                          "interval": "PT10S"
                        }
                      },
                      "runAfter": {}
                    },
                    "Valeurs_techniques_precedentes": {
                      "type": "Compose",
                      "inputs": {
                        "__metadata": {
                          "type": "@{body('Type_entite_colonnes_techniques')?['ListItemEntityTypeFullName']}"
                        },
                        "IdObjet": "@body('Versions_element')?['value']?[1]?['IdObjet']"
                      },
                      "runAfter": {
                        "Type_entite_colonnes_techniques": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Retablir_colonnes_techniques": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "HttpRequest"
                        },
                        "parameters": {
                          "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                          "parameters/method": "POST",
                          "parameters/uri": "@{concat('_api/web/GetList(''', concat(uriPath(parameters('hncs_SiteUrl (hncs_SiteUrl)')), '/LivrablesRD'), ''')/items(', string(triggerOutputs()?['body/ID']), ')')}",
                          "parameters/headers": {
                            "Accept": "application/json;odata=verbose",
                            "Content-Type": "application/json;odata=verbose",
                            "IF-MATCH": "*",
                            "X-HTTP-Method": "MERGE"
                          },
                          "parameters/body": "@{outputs('Valeurs_techniques_precedentes')}"
                        },
                        "authentication": "@parameters('$authentication')",
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 4,
                          "interval": "PT10S"
                        }
                      },
                      "runAfter": {
                        "Valeurs_techniques_precedentes": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Colonnes_techniques_retablies": {
                      "type": "Workflow",
                      "inputs": {
                        "host": {
                          "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                        },
                        "body": {
                          "CodeFlux": "PA-07b",
                          "Niveau": "Avertissement",
                          "Liste": "LivrablesRD",
                          "ItemId": "@{string(coalesce(triggerOutputs()?['body/ID'], ''))}",
                          "IdObjet": "@{coalesce('', '')}",
                          "Message": "@{concat('P-09 : colonne(s) technique(s) modifiée(s) hors flux, rétablie(s) : ', join(body('Colonnes_techniques_modifiees'), ', '))}",
                          "DetailErreur": "@{string(coalesce('', ''))}",
                          "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                        }
                      },
                      "runAfter": {
                        "Retablir_colonnes_techniques": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Dest_N92": {
                      "type": "Select",
                      "inputs": {
                        "from": "@split(concat(coalesce(toLower(coalesce(triggerOutputs()?['body/Editor/Email'], '')), '')), ';')",
                        "select": "@toLower(trim(item()))"
                      },
                      "runAfter": {
                        "Colonnes_techniques_retablies": [
                          "Succeeded"
                        ]
                      }
                    },
                    "DestOK_N92": {
                      "type": "Query",
                      "inputs": {
                        "from": "@body('Dest_N92')",
                        "where": "@not(empty(item()))"
                      },
                      "runAfter": {
                        "Dest_N92": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Si_destinataires_N92": {
                      "type": "If",
                      "expression": "@greater(length(body('DestOK_N92')), 0)",
                      "actions": {
                        "Envoyer_N92": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                              "connectionName": "shared_office365",
                              "operationId": "SharedMailboxSendEmailV2"
                            },
                            "parameters": {
                              "body/MailboxAddress": "@{coalesce(outputs('Parametres')?['Destinataires.BoiteRD'], '')}",
                              "body/To": "@{join(union(body('DestOK_N92'), body('DestOK_N92')), ';')}",
                              "body/Subject": "[HNCS-R&D][N-92] @{''} : modification d'un champ protégé annulée",
                              "body/Body": "<html>\n<head><meta charset=\"utf-8\"><title>[HNCS-R&amp;D][N-92] @{''} : modification d'un champ protégé annulée</title></head>\n<body style=\"font-family:'Segoe UI',Arial,sans-serif;font-size:14px;color:#222222\">\n<p>Bonjour,</p>\n<p>Votre modification de <strong>@{''}</strong> a été annulée : elle portait sur un champ protégé (P-09).</p>\n<ul><li>Champ(s) concerné(s) : @{join(body('Colonnes_techniques_modifiees'), ', ')}</li><li>Rôle habilité : @{'Aucun : colonne technique écrite uniquement par les flux (compte de service)'}</li><li>Valeur rétablie : la dernière valeur validée</li></ul>\n<p>Si la modification est nécessaire, demandez-la à une personne habilitée.</p>\n<p><a href=\"@{concat(parameters('hncs_SiteUrl (hncs_SiteUrl)'), '/LivrablesRD')}\">Ouvrir l'élément</a></p>\n<p style=\"color:#666666;font-size:12px\">Message automatique du système de suivi R&amp;D HNCS : ne pas répondre. Aucune pièce jointe n'est jamais transmise : les documents sont accessibles par lien, selon vos droits.</p>\n</body>\n</html>",
                              "body/Importance": "Normal"
                            },
                            "authentication": "@parameters('$authentication')",
                            "retryPolicy": {
                              "type": "exponential",
                              "count": 4,
                              "interval": "PT10S"
                            }
                          },
                          "runAfter": {}
                        }
                      },
                      "else": {
                        "actions": {
                          "Sans_destinataire_N92": {
                            "type": "Workflow",
                            "inputs": {
                              "host": {
                                "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                              },
                              "body": {
                                "CodeFlux": "PA-07b",
                                "Niveau": "Avertissement",
                                "Liste": "",
                                "ItemId": "@{string(coalesce('', ''))}",
                                "IdObjet": "@{coalesce('', '')}",
                                "Message": "@{'N-92 : aucun destinataire résolu, notification non envoyée'}",
                                "DetailErreur": "@{string(coalesce('', ''))}",
                                "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                              }
                            },
                            "runAfter": {}
                          }
                        }
                      },
                      "runAfter": {
                        "DestOK_N92": [
                          "Succeeded"
                        ]
                      }
                    },
                    "TeamsDest_N92": {
                      "type": "Query",
                      "inputs": {
                        "from": "@split(concat(coalesce(toLower(coalesce(triggerOutputs()?['body/Editor/Email'], '')), '')), ';')",
                        "where": "@not(empty(trim(item())))"
                      },
                      "runAfter": {
                        "Si_destinataires_N92": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Si_teams_N92": {
                      "type": "If",
                      "expression": "@and(equals(coalesce(outputs('Parametres')?['Fonction.NotificationsTeams'], 'Non'), 'Oui'), greater(length(body('TeamsDest_N92')), 0))",
                      "actions": {
                        "Pour_teams_N92": {
                          "type": "Foreach",
                          "foreach": "@union(body('TeamsDest_N92'), body('TeamsDest_N92'))",
                          "actions": {
                            "Teams_N92": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                                  "connectionName": "shared_teams",
                                  "operationId": "PostMessageToConversation"
                                },
                                "parameters": {
                                  "poster": "Flow bot",
                                  "location": "Chat with Flow bot",
                                  "body/recipient": "@{trim(items('Pour_teams_N92'))}",
                                  "body/messageBody": "<p><strong>[HNCS-R&D][N-92] @{''} : modification d'un champ protégé annulée</strong></p><p><a href=\"@{concat(parameters('hncs_SiteUrl (hncs_SiteUrl)'), '/LivrablesRD')}\">Ouvrir dans SharePoint</a></p>"
                                },
                                "authentication": "@parameters('$authentication')",
                                "retryPolicy": {
                                  "type": "exponential",
                                  "count": 4,
                                  "interval": "PT10S"
                                }
                              },
                              "runAfter": {}
                            }
                          },
                          "runtimeConfiguration": {
                            "concurrency": {
                              "repetitions": 1
                            }
                          },
                          "runAfter": {}
                        }
                      },
                      "else": {
                        "actions": {}
                      },
                      "runAfter": {
                        "TeamsDest_N92": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Teams_echec_N92": {
                      "type": "Workflow",
                      "inputs": {
                        "host": {
                          "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                        },
                        "body": {
                          "CodeFlux": "PA-07b",
                          "Niveau": "Avertissement",
                          "Liste": "",
                          "ItemId": "@{string(coalesce('', ''))}",
                          "IdObjet": "@{coalesce('', '')}",
                          "Message": "@{'N-92 : échec de l''envoi Teams (le courriel est parti)'}",
                          "DetailErreur": "@{string(coalesce('', ''))}",
                          "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                        }
                      },
                      "runAfter": {
                        "Si_teams_N92": [
                          "Failed",
                          "TimedOut"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "Colonnes_techniques_modifiees": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Versions_element": [
                  "Succeeded",
                  "Failed"
                ]
              }
            },
            "Lire_livrable": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItem"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Livrables",
                  "id": "@triggerOutputs()?['body/Livrable/Id']"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Si_modification_humaine_a_verifier": [
                  "Succeeded"
                ]
              }
            },
            "Metadonnees_document": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchFileItem"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "04 - Livrables R&D",
                  "id": "@triggerOutputs()?['body/ID']",
                  "item/IdObjet": "@{body('Lire_livrable')?['IdHNCS']}",
                  "item/Sujet/Id": "@coalesce(triggerOutputs()?['body/Sujet/Id'], body('Lire_livrable')?['Sujet']?['Id'])"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Lire_livrable": [
                  "Succeeded"
                ]
              }
            },
            "Si_LienDocument_vide": {
              "type": "If",
              "expression": "@empty(body('Lire_livrable')?['LienDocument'])",
              "actions": {
                "Renseigner_LienDocument": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                      "table": "Livrables",
                      "id": "@body('Lire_livrable')?['ID']",
                      "item/LienDocument": "@{triggerOutputs()?['body/{Link}']}",
                      "item/Affectation/Id": "@body('Lire_livrable')?['Affectation']?['Id']",
                      "item/TypeLivrable/Value": "@{body('Lire_livrable')?['TypeLivrable']?['Value']}",
                      "item/Proprietaire/Claims": "@{body('Lire_livrable')?['Proprietaire']?['Claims']}",
                      "item/Echeance": "@body('Lire_livrable')?['Echeance']",
                      "item/Statut/Value": "@{body('Lire_livrable')?['Statut']?['Value']}",
                      "item/Title": "@body('Lire_livrable')?['Title']"
                    },
                    "authentication": "@parameters('$authentication')",
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 4,
                      "interval": "PT10S"
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Metadonnees_document": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Erreur": {
          "type": "Scope",
          "actions": {
            "Detail_erreur": {
              "type": "Compose",
              "inputs": "@string(result('Principal'))",
              "runAfter": {}
            },
            "Journaliser_erreur": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                },
                "body": {
                  "CodeFlux": "PA-07b",
                  "Niveau": "Erreur",
                  "Liste": "LivrablesRD",
                  "ItemId": "@{string(coalesce(triggerOutputs()?['body/ID'], ''))}",
                  "IdObjet": "@{coalesce('', '')}",
                  "Message": "@{'Échec de l''exécution du flux PA-07b'}",
                  "DetailErreur": "@{string(coalesce(substring(outputs('Detail_erreur'), 0, min(length(outputs('Detail_erreur')), 8000)), ''))}",
                  "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                }
              },
              "runAfter": {
                "Detail_erreur": [
                  "Succeeded"
                ]
              }
            },
            "Terminer_en_echec": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "HNCS_ECHEC",
