{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hncs_sharepoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "hncs_SiteUrl (hncs_SiteUrl)": {
          "defaultValue": "https://contoso.sharepoint.com/sites/HNCS-RD",
          "type": "String",
          "metadata": {
            "schemaName": "hncs_SiteUrl",
            "description": "URL du site SharePoint HNCS-R&D (sans barre finale)"
          }
        },
        "hncs_ServiceAccountEmail (hncs_ServiceAccountEmail)": {
          "defaultValue": "svc-hncs-rd@contoso.com",
          "type": "String",
          "metadata": {
            "schemaName": "hncs_ServiceAccountEmail",
            "description": "Adresse du compte de service des flux (rôle FLUX)"
          }
        }
      },
      "triggers": {
        "Quand_un_element_est_cree": {
          "type": "OpenApiConnection",
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnNewItems"
            },
            "parameters": {
              "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
              "table": "Échanges avec les écoles"
            },
            "authentication": "@parameters('$authentication')"
          },
          "conditions": [
            {
              "expression": "@not(equals(toLower(triggerOutputs()?['body/Editor/Email']), toLower(parameters('hncs_ServiceAccountEmail (hncs_ServiceAccountEmail)'))))"
            }
          ]
        }
      },
      "actions": {
        "Principal": {
          "type": "Scope",
          "actions": {
            "Lire_parametres": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Paramètres",
                  "$filter": "Categorie eq 'Destinataires' or Categorie eq 'Délais' or Categorie eq 'Fonctionnalités' or Categorie eq 'Conservation' or Categorie eq 'Liens' or Categorie eq 'Gouvernance' or Categorie eq 'Canaux'",
                  "$top": 500
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {}
            },
            "Parametres_cles_valeurs": {
              "type": "Select",
              "inputs": {
                "from": "@body('Lire_parametres')?['value']",
                "select": "@concat('\"', replace(item()?['Title'], '\"', ''), '\":', if(empty(item()?['Valeur']), 'null', concat('\"', replace(replace(item()?['Valeur'], '\\', '\\\\'), '\"', '\\\"'), '\"')))"
              },
              "runAfter": {
                "Lire_parametres": [
                  "Succeeded"
                ]
              }
            },
            "Parametres": {
              "type": "Compose",
              "inputs": "@json(concat('{', join(body('Parametres_cles_valeurs'), ','), '}'))",
              "runAfter": {
                "Parametres_cles_valeurs": [
                  "Succeeded"
                ]
              }
            },
            "Aujourdhui": {
              "type": "Compose",
              "inputs": "@formatDateTime(convertTimeZone(utcNow(), 'UTC', 'Romance Standard Time'), 'yyyy-MM-dd')",
              "runAfter": {
                "Parametres": [
                  "Succeeded"
                ]
              }
            },
            "Lire_element": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItem"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Échanges avec les écoles",
                  "id": "@triggerOutputs()?['body/ID']"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Aujourdhui": [
                  "Succeeded"
                ]
              }
            },
            "IdObjet_el": {
              "type": "Compose",
              "inputs": "@if(empty(body('Lire_element')?['IdHNCS']), concat('INT-', formatDateTime(convertTimeZone(body('Lire_element')?['Created'], 'UTC', 'Romance Standard Time'), 'yyyy'), '-', formatNumber(int(body('Lire_element')?['ID']), '0000')), body('Lire_element')?['IdHNCS'])",
              "runAfter": {
                "Lire_element": [
                  "Succeeded"
                ]
              }
            },
            "Si_IdHNCS_vide_el": {
              "type": "If",
              "expression": "@empty(body('Lire_element')?['IdHNCS'])",
              "actions": {
                "Ecrire_IdHNCS_el": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                      "table": "Échanges avec les écoles",
                      "id": "@body('Lire_element')?['ID']",
                      "item/IdHNCS": "@{outputs('IdObjet_el')}",
                      "item/Etablissement/Id": "@body('Lire_element')?['Etablissement']?['Id']",
                      "item/DateInteraction": "@body('Lire_element')?['DateInteraction']",
                      "item/Title": "@body('Lire_element')?['Title']"
                    },
                    "authentication": "@parameters('$authentication')",
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 4,
                      "interval": "PT10S"
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "IdObjet_el": [
                  "Succeeded"
                ]
              }
            },
            "Lire_etablissement": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItem"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Écoles et établissements",
                  "id": "@body('Lire_element')?['Etablissement']?['Id']"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Si_IdHNCS_vide_el": [
                  "Succeeded"
                ]
              }
            },
            "Mettre_a_jour_etablissement": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Écoles et établissements",
                  "id": "@body('Lire_etablissement')?['ID']",
                  "item/DateDerniereInteraction": "@{if(or(empty(body('Lire_etablissement')?['DateDerniereInteraction']), greater(if(empty(body('Lire_element')?['DateInteraction']), '', formatDateTime(convertTimeZone(body('Lire_element')?['DateInteraction'], 'UTC', 'Romance Standard Time'), 'yyyy-MM-dd')), if(empty(body('Lire_etablissement')?['DateDerniereInteraction']), '', formatDateTime(convertTimeZone(body('Lire_etablissement')?['DateDerniereInteraction'], 'UTC', 'Romance Standard Time'), 'yyyy-MM-dd')))), if(empty(body('Lire_element')?['DateInteraction']), '', formatDateTime(convertTimeZone(body('Lire_element')?['DateInteraction'], 'UTC', 'Romance Standard Time'), 'yyyy-MM-dd')), if(empty(body('Lire_etablissement')?['DateDerniereInteraction']), '', formatDateTime(convertTimeZone(body('Lire_etablissement')?['DateDerniereInteraction'], 'UTC', 'Romance Standard Time'), 'yyyy-MM-dd')))}",
                  "item/ProchaineAction": "@if(empty(body('Lire_element')?['ProchaineAction']), body('Lire_etablissement')?['ProchaineAction'], body('Lire_element')?['ProchaineAction'])",
                  "item/DateProchaineAction": "@if(empty(body('Lire_element')?['DateProchaineAction']), body('Lire_etablissement')?['DateProchaineAction'], if(empty(body('Lire_element')?['DateProchaineAction']), '', formatDateTime(convertTimeZone(body('Lire_element')?['DateProchaineAction'], 'UTC', 'Romance Standard Time'), 'yyyy-MM-dd')))",
                  "item/Statut/Value": "@{body('Lire_etablissement')?['Statut']?['Value']}",
                  "item/Title": "@body('Lire_etablissement')?['Title']"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Lire_etablissement": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Erreur": {
          "type": "Scope",
          "actions": {
            "Detail_erreur": {
              "type": "Compose",
              "inputs": "@string(result('Principal'))",
              "runAfter": {}
            },
            "Journaliser_erreur": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                },
                "body": {
                  "CodeFlux": "PA-10",
                  "Niveau": "Erreur",
                  "Liste": "InteractionsEcoles",
                  "ItemId": "@{string(coalesce(triggerOutputs()?['body/ID'], ''))}",
                  "IdObjet": "@{coalesce(triggerOutputs()?['body/IdHNCS'], '')}",
                  "Message": "@{'Échec de l''exécution du flux PA-10-int'}",
                  "DetailErreur": "@{string(coalesce(substring(outputs('Detail_erreur'), 0, min(length(outputs('Detail_erreur')), 8000)), ''))}",
                  "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                }
              },
              "runAfter": {
                "Detail_erreur": [
                  "Succeeded"
                ]
              }
            },
            "Terminer_en_echec": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "HNCS_ECHEC",
                  "message": "Échec du flux PA-10-int : voir le journal des flux"
                }
              },
              "runAfter": {
                "Journaliser_erreur": [
                  "Succeeded",
                  "Failed",
                  "TimedOut",
                  "Skipped"
                ]
              }
            }
          },
          "runAfter": {
            "Principal": [
              "Failed",
              "TimedOut"
            ]
          }
        },
        "Terminer": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Succeeded"
          },
          "runAfter": {
            "Erreur": [
              "Skipped"
            ]
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
