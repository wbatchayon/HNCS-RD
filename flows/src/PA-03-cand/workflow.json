{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hncs_outlook"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hncs_sharepoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_teams": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hncs_teams"
        },
        "api": {
          "name": "shared_teams"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "hncs_SiteUrl (hncs_SiteUrl)": {
          "defaultValue": "https://contoso.sharepoint.com/sites/HNCS-RD",
          "type": "String",
          "metadata": {
            "schemaName": "hncs_SiteUrl",
            "description": "URL du site SharePoint HNCS-R&D (sans barre finale)"
          }
        },
        "hncs_ServiceAccountEmail (hncs_ServiceAccountEmail)": {
          "defaultValue": "svc-hncs-rd@contoso.com",
          "type": "String",
          "metadata": {
            "schemaName": "hncs_ServiceAccountEmail",
            "description": "Adresse du compte de service des flux (rôle FLUX)"
          }
        }
      },
      "triggers": {
        "Quand_un_element_est_cree_ou_modifie": {
          "type": "OpenApiConnection",
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnUpdatedItems"
            },
            "parameters": {
              "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
              "table": "Candidatures"
            },
            "authentication": "@parameters('$authentication')"
          },
          "conditions": [
            {
              "expression": "@not(equals(toLower(triggerOutputs()?['body/Editor/Email']), toLower(parameters('hncs_ServiceAccountEmail (hncs_ServiceAccountEmail)'))))"
            },
            {
              "expression": "@not(equals(coalesce(triggerOutputs()?['body/Statut/Value'], ''), coalesce(triggerOutputs()?['body/StatutPrecedent'], '')))"
            },
            {
              "expression": "@contains(createArray('Entretien planifié', 'Entretien réalisé', 'En attente de décision', 'Retenue'), triggerOutputs()?['body/Statut/Value'])"
            }
          ]
        }
      },
      "actions": {
        "Principal": {
          "type": "Scope",
          "actions": {
            "Lire_parametres": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Paramètres",
                  "$filter": "Categorie eq 'Destinataires' or Categorie eq 'Délais' or Categorie eq 'Fonctionnalités' or Categorie eq 'Conservation' or Categorie eq 'Liens' or Categorie eq 'Gouvernance' or Categorie eq 'Canaux'",
                  "$top": 500
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {}
            },
            "Parametres_cles_valeurs": {
              "type": "Select",
              "inputs": {
                "from": "@body('Lire_parametres')?['value']",
                "select": "@concat('\"', replace(item()?['Title'], '\"', ''), '\":', if(empty(item()?['Valeur']), 'null', concat('\"', replace(replace(item()?['Valeur'], '\\', '\\\\'), '\"', '\\\"'), '\"')))"
              },
              "runAfter": {
                "Lire_parametres": [
                  "Succeeded"
                ]
              }
            },
            "Parametres": {
              "type": "Compose",
              "inputs": "@json(concat('{', join(body('Parametres_cles_valeurs'), ','), '}'))",
              "runAfter": {
                "Parametres_cles_valeurs": [
                  "Succeeded"
                ]
              }
            },
            "Aujourdhui": {
              "type": "Compose",
              "inputs": "@formatDateTime(convertTimeZone(utcNow(), 'UTC', 'Romance Standard Time'), 'yyyy-MM-dd')",
              "runAfter": {
                "Parametres": [
                  "Succeeded"
                ]
              }
            },
            "Membres_G_ADM": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/sitegroups/getbyname('HNCS-RD-Administration')/users?$select=Email",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Aujourdhui": [
                  "Succeeded"
                ]
              }
            },
            "Emails_G_ADM": {
              "type": "Select",
              "inputs": {
                "from": "@body('Membres_G_ADM')?['value']",
                "select": "@toLower(coalesce(item()?['Email'], ''))"
              },
              "runAfter": {
                "Membres_G_ADM": [
                  "Succeeded"
                ]
              }
            },
            "Lire_element": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItem"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Candidatures",
                  "id": "@triggerOutputs()?['body/ID']"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Emails_G_ADM": [
                  "Succeeded"
                ]
              }
            },
            "Si_evenement_obsolete": {
              "type": "If",
              "expression": "@not(equals(body('Lire_element')?['Statut']?['Value'], triggerOutputs()?['body/Statut/Value']))",
              "actions": {
                "Fin_evenement_obsolete": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Succeeded"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Lire_element": [
                  "Succeeded"
                ]
              }
            },
            "IdObjet_el": {
              "type": "Compose",
              "inputs": "@if(empty(body('Lire_element')?['IdHNCS']), concat('CAND-', formatDateTime(convertTimeZone(body('Lire_element')?['Created'], 'UTC', 'Romance Standard Time'), 'yyyy'), '-', formatNumber(int(body('Lire_element')?['ID']), '0000')), body('Lire_element')?['IdHNCS'])",
              "runAfter": {
                "Si_evenement_obsolete": [
                  "Succeeded"
                ]
              }
            },
            "Si_IdHNCS_vide_el": {
              "type": "If",
              "expression": "@empty(body('Lire_element')?['IdHNCS'])",
              "actions": {
                "Ecrire_IdHNCS_el": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                      "table": "Candidatures",
                      "id": "@body('Lire_element')?['ID']",
                      "item/IdHNCS": "@{outputs('IdObjet_el')}",
                      "item/Canal/Value": "@{body('Lire_element')?['Canal']?['Value']}",
                      "item/ModeReception/Value": "@{body('Lire_element')?['ModeReception']?['Value']}",
                      "item/DateReception": "@body('Lire_element')?['DateReception']",
                      "item/Statut/Value": "@{body('Lire_element')?['Statut']?['Value']}",
                      "item/Title": "@body('Lire_element')?['Title']"
                    },
                    "authentication": "@parameters('$authentication')",
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 4,
                      "interval": "PT10S"
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "IdObjet_el": [
                  "Succeeded"
                ]
              }
            },
            "Statut_avant": {
              "type": "Compose",
              "inputs": "@if(empty(body('Lire_element')?['StatutPrecedent']), '∅', body('Lire_element')?['StatutPrecedent'])",
              "runAfter": {
                "Si_IdHNCS_vide_el": [
                  "Succeeded"
                ]
              }
            },
            "Si_aucune_transition_a_traiter": {
              "type": "If",
              "expression": "@not(and(not(equals(body('Lire_element')?['Statut']?['Value'], coalesce(body('Lire_element')?['StatutPrecedent'], ''))), contains(createArray('Entretien planifié', 'Entretien réalisé', 'En attente de décision', 'Retenue'), body('Lire_element')?['Statut']?['Value'])))",
              "actions": {
                "Fin_sans_transition": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Succeeded"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Statut_avant": [
                  "Succeeded"
                ]
              }
            },
            "Verifier_transition": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "fa7991cb-62cf-5740-a458-f1a6db5ab0eb"
                },
                "body": {
                  "Objet": "Candidature",
                  "StatutAvant": "@{outputs('Statut_avant')}",
                  "StatutApres": "@{body('Lire_element')?['Statut']?['Value']}",
                  "ActeurEmail": "@{toLower(coalesce(triggerOutputs()?['body/Editor/Email'], ''))}",
                  "ItemAuteurEmail": "@{coalesce('', '')}",
                  "ItemValideurEmail": "@{coalesce('', '')}"
                }
              },
              "runAfter": {
                "Si_aucune_transition_a_traiter": [
                  "Succeeded"
                ]
              }
            },
            "Si_erreur_controle_Verifier_transition": {
              "type": "If",
              "expression": "@equals(coalesce(body('Verifier_transition')?['Motif'], ''), 'Erreur technique de contrôle')",
              "actions": {
                "Journaliser_erreur_controle_Verifier_transition": {
                  "type": "Workflow",
                  "inputs": {
                    "host": {
                      "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                    },
                    "body": {
                      "CodeFlux": "PA-03",
                      "Niveau": "Erreur",
                      "Liste": "Candidatures",
                      "ItemId": "@{string(coalesce(body('Lire_element')?['ID'], ''))}",
                      "IdObjet": "@{coalesce(outputs('IdObjet_el'), '')}",
                      "Message": "@{'PA-00A : erreur technique de contrôle, transition refusée par sécurité'}",
                      "DetailErreur": "@{string(coalesce('', ''))}",
                      "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Verifier_transition": [
                  "Succeeded"
                ]
              }
            },
            "Entretiens_el": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Entretiens",
                  "$filter": "CandidatureId eq @{body('Lire_element')?['ID']}",
                  "$top": 5000
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Si_erreur_controle_Verifier_transition": [
                  "Succeeded"
                ]
              }
            },
            "Entretiens_planifies_el": {
              "type": "Query",
              "inputs": {
                "from": "@body('Entretiens_el')?['value']",
                "where": "@equals(item()?['Statut']?['Value'], 'Planifié')"
              },
              "runAfter": {
                "Entretiens_el": [
                  "Succeeded"
                ]
              }
            },
            "Entretiens_realises_el": {
              "type": "Query",
              "inputs": {
                "from": "@body('Entretiens_el')?['value']",
                "where": "@equals(item()?['Statut']?['Value'], 'Réalisé')"
              },
              "runAfter": {
                "Entretiens_planifies_el": [
                  "Succeeded"
                ]
              }
            },
            "Entretiens_resultat_el": {
              "type": "Query",
              "inputs": {
                "from": "@body('Entretiens_realises_el')",
                "where": "@not(empty(item()?['Resultat']?['Value']))"
              },
              "runAfter": {
                "Entretiens_realises_el": [
                  "Succeeded"
                ]
              }
            },
            "Controles_el": {
              "type": "Compose",
              "inputs": "@split(replace(coalesce(body('Verifier_transition')?['Controles'], ''), ' ', ''), ';')",
              "runAfter": {
                "Entretiens_resultat_el": [
                  "Succeeded"
                ]
              }
            },
            "Controles_inconnus_el": {
              "type": "Query",
              "inputs": {
                "from": "@outputs('Controles_el')",
                "where": "@and(not(empty(item())), not(contains(createArray('G_DECISION_FINALE', 'G_ENTRETIEN_PLANIFIE', 'G_ENTRETIEN_REALISE'), item())))"
              },
              "runAfter": {
                "Controles_el": [
                  "Succeeded"
                ]
              }
            },
            "Controles_echec_el": {
              "type": "Query",
              "inputs": {
                "from": "@createArray(if(and(contains(outputs('Controles_el'), 'G_DECISION_FINALE'), not(and(not(empty(body('Lire_element')?['DecideurFinal']?['Email'])), greater(length(body('Entretiens_realises_el')), 0)))), 'G_DECISION_FINALE (DecideurFinal renseigné et au moins un entretien « Réalisé »)', ''), if(and(contains(outputs('Controles_el'), 'G_ENTRETIEN_PLANIFIE'), not(greater(length(body('Entretiens_planifies_el')), 0))), 'G_ENTRETIEN_PLANIFIE (Au moins un élément Entretiens lié au statut « Planifié »)', ''), if(and(contains(outputs('Controles_el'), 'G_ENTRETIEN_REALISE'), not(greater(length(body('Entretiens_resultat_el')), 0))), 'G_ENTRETIEN_REALISE (Au moins un entretien lié « Réalisé » avec Resultat renseigné)', ''))",
                "where": "@not(empty(item()))"
              },
              "runAfter": {
                "Controles_inconnus_el": [
                  "Succeeded"
                ]
              }
            },
            "Si_transition_refusee": {
              "type": "If",
              "expression": "@not(and(equals(toLower(string(coalesce(body('Verifier_transition')?['Autorise'], false))), 'true'), and(empty(body('Controles_echec_el')), empty(body('Controles_inconnus_el')))))",
              "actions": {
                "Annuler_transition": {
                  "type": "Workflow",
                  "inputs": {
                    "host": {
                      "workflowReferenceName": "d12115ea-8f45-524c-b8b1-f7a45e1e278d"
                    },
                    "body": {
                      "Liste": "Candidatures",
                      "ItemId": "@int(body('Lire_element')?['ID'])",
                      "IdObjet": "@{outputs('IdObjet_el')}",
                      "Objet": "Candidature",
                      "StatutAvant": "@{outputs('Statut_avant')}",
                      "StatutApres": "@{body('Lire_element')?['Statut']?['Value']}",
                      "Accepte": "@false",
                      "CodeTransition": "@{coalesce(body('Verifier_transition')?['CodeTransition'], '')}",
                      "ActeurEmail": "@{toLower(coalesce(triggerOutputs()?['body/Editor/Email'], ''))}",
                      "Origine": "Humain",
                      "Motif": "@{coalesce(if(equals(toLower(string(coalesce(body('Verifier_transition')?['Autorise'], false))), 'true'), concat('Contrôle(s) non satisfait(s) : ', join(union(body('Controles_echec_el'), body('Controles_inconnus_el')), ' ; ')), coalesce(body('Verifier_transition')?['Motif'], 'Transition non autorisée')), '')}",
                      "RunId": "@{workflow()?['run']?['name']}"
                    }
                  },
                  "runAfter": {}
                },
                "Fin_transition_refusee": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Succeeded"
                  },
                  "runAfter": {
                    "Annuler_transition": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Controles_echec_el": [
                  "Succeeded"
                ]
              }
            },
            "Effets_par_statut": {
              "type": "Switch",
              "expression": "@body('Lire_element')?['Statut']?['Value']",
              "cases": {
                "Cas_1_En_attente_de_decision": {
                  "case": "En attente de décision",
                  "actions": {
                    "Dest_N12": {
                      "type": "Select",
                      "inputs": {
                        "from": "@split(concat(coalesce(coalesce(outputs('Parametres')?['Destinataires.Administration'], ''), '')), ';')",
                        "select": "@toLower(trim(item()))"
                      },
                      "runAfter": {}
                    },
                    "DestOK_N12": {
                      "type": "Query",
                      "inputs": {
                        "from": "@body('Dest_N12')",
                        "where": "@not(empty(item()))"
                      },
                      "runAfter": {
                        "Dest_N12": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Si_destinataires_N12": {
                      "type": "If",
                      "expression": "@greater(length(body('DestOK_N12')), 0)",
                      "actions": {
                        "Envoyer_N12": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                              "connectionName": "shared_office365",
                              "operationId": "SharedMailboxSendEmailV2"
                            },
                            "parameters": {
                              "body/MailboxAddress": "@{coalesce(outputs('Parametres')?['Destinataires.BoiteRD'], '')}",
                              "body/To": "@{join(union(body('DestOK_N12'), body('DestOK_N12')), ';')}",
                              "body/Subject": "[HNCS-R&D][N-12] Décision attendue pour @{outputs('IdObjet_el')}",
                              "body/Body": "<html>\n<head><meta charset=\"utf-8\"><title>[HNCS-R&amp;D][N-12] Décision attendue pour @{outputs('IdObjet_el')}</title></head>\n<body style=\"font-family:'Segoe UI',Arial,sans-serif;font-size:14px;color:#222222\">\n<p>Bonjour,</p>\n<p>La candidature <strong>@{outputs('IdObjet_el')}</strong> (@{body('Lire_element')?['Title']}) est en attente de décision finale.</p>\n<p><a href=\"@{concat(parameters('hncs_SiteUrl (hncs_SiteUrl)'), '/Lists/Candidatures/DispForm.aspx?ID=', string(body('Lire_element')?['ID']))}\">Ouvrir la candidature</a></p>\n<p style=\"color:#666666;font-size:12px\">Message automatique du système de suivi R&amp;D HNCS — ne pas répondre. Aucune pièce jointe n'est jamais transmise : les documents sont accessibles par lien, selon vos droits.</p>\n</body>\n</html>",
                              "body/Importance": "Normal"
                            },
                            "authentication": "@parameters('$authentication')",
                            "retryPolicy": {
                              "type": "exponential",
                              "count": 4,
                              "interval": "PT10S"
                            }
                          },
                          "runAfter": {}
                        }
                      },
                      "else": {
                        "actions": {
                          "Sans_destinataire_N12": {
                            "type": "Workflow",
                            "inputs": {
                              "host": {
                                "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                              },
                              "body": {
                                "CodeFlux": "PA-03",
                                "Niveau": "Avertissement",
                                "Liste": "",
                                "ItemId": "@{string(coalesce('', ''))}",
                                "IdObjet": "@{coalesce('', '')}",
                                "Message": "@{'N-12 : aucun destinataire résolu, notification non envoyée'}",
                                "DetailErreur": "@{string(coalesce('', ''))}",
                                "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                              }
                            },
                            "runAfter": {}
                          }
                        }
                      },
                      "runAfter": {
                        "DestOK_N12": [
                          "Succeeded"
                        ]
                      }
                    }
                  }
                },
                "Cas_2_Retenue": {
                  "case": "Retenue",
                  "actions": {
                    "Date_decision_finale": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PatchItem"
                        },
                        "parameters": {
                          "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                          "table": "Candidatures",
                          "id": "@body('Lire_element')?['ID']",
                          "item/DateDecisionFinale": "@coalesce(body('Lire_element')?['DateDecisionFinale'], utcNow())",
                          "item/Canal/Value": "@{body('Lire_element')?['Canal']?['Value']}",
                          "item/ModeReception/Value": "@{body('Lire_element')?['ModeReception']?['Value']}",
                          "item/DateReception": "@body('Lire_element')?['DateReception']",
                          "item/Statut/Value": "@{body('Lire_element')?['Statut']?['Value']}",
                          "item/Title": "@body('Lire_element')?['Title']"
                        },
                        "authentication": "@parameters('$authentication')",
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 4,
                          "interval": "PT10S"
                        }
                      },
                      "runAfter": {}
                    },
                    "Dest_N13": {
                      "type": "Select",
                      "inputs": {
                        "from": "@split(concat(coalesce(join(body('Emails_G_ADM'), ';'), ''), ';', coalesce(body('Lire_element')?['ResponsableAnalyse']?['Email'], '')), ';')",
                        "select": "@toLower(trim(item()))"
                      },
                      "runAfter": {
                        "Date_decision_finale": [
                          "Succeeded"
                        ]
                      }
                    },
                    "DestOK_N13": {
                      "type": "Query",
                      "inputs": {
                        "from": "@body('Dest_N13')",
                        "where": "@not(empty(item()))"
                      },
                      "runAfter": {
                        "Dest_N13": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Si_destinataires_N13": {
                      "type": "If",
                      "expression": "@greater(length(body('DestOK_N13')), 0)",
                      "actions": {
                        "Envoyer_N13": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                              "connectionName": "shared_office365",
                              "operationId": "SharedMailboxSendEmailV2"
                            },
                            "parameters": {
                              "body/MailboxAddress": "@{coalesce(outputs('Parametres')?['Destinataires.BoiteRD'], '')}",
                              "body/To": "@{join(union(body('DestOK_N13'), body('DestOK_N13')), ';')}",
                              "body/Subject": "[HNCS-R&D][N-13] Candidature @{outputs('IdObjet_el')} retenue",
                              "body/Body": "<html>\n<head><meta charset=\"utf-8\"><title>[HNCS-R&amp;D][N-13] Candidature @{outputs('IdObjet_el')} retenue</title></head>\n<body style=\"font-family:'Segoe UI',Arial,sans-serif;font-size:14px;color:#222222\">\n<p>Bonjour,</p>\n<p>La candidature <strong>@{outputs('IdObjet_el')}</strong> (@{body('Lire_element')?['Title']}) a été retenue.</p>\n<p>Rappel : l'administration doit autoriser le lancement des formalités (statut « Formalités en cours »). Cette autorisation reste une action humaine.</p>\n<p><a href=\"@{concat(parameters('hncs_SiteUrl (hncs_SiteUrl)'), '/Lists/Candidatures/DispForm.aspx?ID=', string(body('Lire_element')?['ID']))}\">Ouvrir la candidature</a></p>\n<p style=\"color:#666666;font-size:12px\">Message automatique du système de suivi R&amp;D HNCS — ne pas répondre. Aucune pièce jointe n'est jamais transmise : les documents sont accessibles par lien, selon vos droits.</p>\n</body>\n</html>",
                              "body/Importance": "Normal"
                            },
                            "authentication": "@parameters('$authentication')",
                            "retryPolicy": {
                              "type": "exponential",
                              "count": 4,
                              "interval": "PT10S"
                            }
                          },
                          "runAfter": {}
                        }
                      },
                      "else": {
                        "actions": {
                          "Sans_destinataire_N13": {
                            "type": "Workflow",
                            "inputs": {
                              "host": {
                                "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                              },
                              "body": {
                                "CodeFlux": "PA-03",
                                "Niveau": "Avertissement",
                                "Liste": "",
                                "ItemId": "@{string(coalesce('', ''))}",
                                "IdObjet": "@{coalesce('', '')}",
                                "Message": "@{'N-13 : aucun destinataire résolu, notification non envoyée'}",
                                "DetailErreur": "@{string(coalesce('', ''))}",
                                "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                              }
                            },
                            "runAfter": {}
                          }
                        }
                      },
                      "runAfter": {
                        "DestOK_N13": [
                          "Succeeded"
                        ]
                      }
                    },
                    "TeamsDest_N13": {
                      "type": "Query",
                      "inputs": {
                        "from": "@split(concat(coalesce(body('Lire_element')?['ResponsableAnalyse']?['Email'], '')), ';')",
                        "where": "@not(empty(trim(item())))"
                      },
                      "runAfter": {
                        "Si_destinataires_N13": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Si_teams_N13": {
                      "type": "If",
                      "expression": "@and(equals(coalesce(outputs('Parametres')?['Fonction.NotificationsTeams'], 'Non'), 'Oui'), greater(length(body('TeamsDest_N13')), 0))",
                      "actions": {
                        "Pour_teams_N13": {
                          "type": "Foreach",
                          "foreach": "@union(body('TeamsDest_N13'), body('TeamsDest_N13'))",
                          "actions": {
                            "Teams_N13": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                                  "connectionName": "shared_teams",
                                  "operationId": "PostMessageToConversation"
                                },
                                "parameters": {
                                  "poster": "Flow bot",
                                  "location": "Chat with Flow bot",
                                  "body/recipient": "@{trim(items('Pour_teams_N13'))}",
                                  "body/messageBody": "<p><strong>[HNCS-R&D][N-13] Candidature @{outputs('IdObjet_el')} retenue</strong></p><p><a href=\"@{concat(parameters('hncs_SiteUrl (hncs_SiteUrl)'), '/Lists/Candidatures/DispForm.aspx?ID=', string(body('Lire_element')?['ID']))}\">Ouvrir dans SharePoint</a></p>"
                                },
                                "authentication": "@parameters('$authentication')",
                                "retryPolicy": {
                                  "type": "exponential",
                                  "count": 4,
                                  "interval": "PT10S"
                                }
                              },
                              "runAfter": {}
                            }
                          },
                          "runtimeConfiguration": {
                            "concurrency": {
                              "repetitions": 1
                            }
                          },
                          "runAfter": {}
                        }
                      },
                      "else": {
                        "actions": {}
                      },
                      "runAfter": {
                        "TeamsDest_N13": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Teams_echec_N13": {
                      "type": "Workflow",
                      "inputs": {
                        "host": {
                          "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                        },
                        "body": {
                          "CodeFlux": "PA-03",
                          "Niveau": "Avertissement",
                          "Liste": "",
                          "ItemId": "@{string(coalesce('', ''))}",
                          "IdObjet": "@{coalesce('', '')}",
                          "Message": "@{'N-13 : échec de l''envoi Teams (le courriel est parti)'}",
                          "DetailErreur": "@{string(coalesce('', ''))}",
                          "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                        }
                      },
                      "runAfter": {
                        "Si_teams_N13": [
                          "Failed",
                          "TimedOut"
                        ]
                      }
                    }
                  }
                }
              },
              "default": {
                "actions": {}
              },
              "runAfter": {
                "Si_transition_refusee": [
                  "Succeeded"
                ]
              }
            },
            "Historiser_transition": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "d12115ea-8f45-524c-b8b1-f7a45e1e278d"
                },
                "body": {
                  "Liste": "Candidatures",
                  "ItemId": "@int(body('Lire_element')?['ID'])",
                  "IdObjet": "@{outputs('IdObjet_el')}",
                  "Objet": "Candidature",
                  "StatutAvant": "@{outputs('Statut_avant')}",
                  "StatutApres": "@{body('Lire_element')?['Statut']?['Value']}",
                  "Accepte": "@true",
                  "CodeTransition": "@{coalesce(body('Verifier_transition')?['CodeTransition'], '')}",
                  "ActeurEmail": "@{toLower(coalesce(triggerOutputs()?['body/Editor/Email'], ''))}",
                  "Origine": "Humain",
                  "Motif": "@{coalesce('', '')}",
                  "RunId": "@{workflow()?['run']?['name']}"
                }
              },
              "runAfter": {
                "Effets_par_statut": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Erreur": {
          "type": "Scope",
          "actions": {
            "Detail_erreur": {
              "type": "Compose",
              "inputs": "@string(result('Principal'))",
              "runAfter": {}
            },
            "Journaliser_erreur": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                },
                "body": {
                  "CodeFlux": "PA-03",
                  "Niveau": "Erreur",
                  "Liste": "Candidatures",
                  "ItemId": "@{string(coalesce(triggerOutputs()?['body/ID'], ''))}",
                  "IdObjet": "@{coalesce(triggerOutputs()?['body/IdHNCS'], '')}",
                  "Message": "@{'Échec de l''exécution du flux PA-03-cand'}",
                  "DetailErreur": "@{string(coalesce(substring(outputs('Detail_erreur'), 0, min(length(outputs('Detail_erreur')), 8000)), ''))}",
                  "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                }
              },
              "runAfter": {
                "Detail_erreur": [
                  "Succeeded"
                ]
              }
            },
            "Terminer_en_echec": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "HNCS_ECHEC",
                  "message": "Échec du flux PA-03-cand : voir le journal des flux"
                }
              },
              "runAfter": {
                "Journaliser_erreur": [
                  "Succeeded",
                  "Failed",
                  "TimedOut",
                  "Skipped"
                ]
              }
            }
          },
          "runAfter": {
            "Principal": [
              "Failed",
              "TimedOut"
            ]
          }
        },
        "Terminer": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Succeeded"
          },
          "runAfter": {
            "Erreur": [
              "Skipped"
            ]
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
