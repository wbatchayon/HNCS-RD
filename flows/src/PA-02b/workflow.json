{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hncs_outlook"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hncs_sharepoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "hncs_SiteUrl (hncs_SiteUrl)": {
          "defaultValue": "https://contoso.sharepoint.com/sites/HNCS-RD",
          "type": "String",
          "metadata": {
            "schemaName": "hncs_SiteUrl",
            "description": "URL du site SharePoint HNCS-R&D (sans barre finale)"
          }
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "schedule": {
              "hours": [
                "8"
              ],
              "minutes": [
                0
              ]
            },
            "timeZone": "Romance Standard Time"
          }
        }
      },
      "actions": {
        "Principal": {
          "type": "Scope",
          "actions": {
            "Lire_parametres": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Paramètres",
                  "$filter": "Categorie eq 'Destinataires' or Categorie eq 'Délais' or Categorie eq 'Fonctionnalités' or Categorie eq 'Conservation' or Categorie eq 'Liens' or Categorie eq 'Gouvernance' or Categorie eq 'Canaux'",
                  "$top": 500
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {}
            },
            "Parametres_cles_valeurs": {
              "type": "Select",
              "inputs": {
                "from": "@body('Lire_parametres')?['value']",
                "select": "@concat('\"', replace(item()?['Title'], '\"', ''), '\":', if(empty(item()?['Valeur']), 'null', concat('\"', replace(replace(item()?['Valeur'], '\\', '\\\\'), '\"', '\\\"'), '\"')))"
              },
              "runAfter": {
                "Lire_parametres": [
                  "Succeeded"
                ]
              }
            },
            "Parametres": {
              "type": "Compose",
              "inputs": "@json(concat('{', join(body('Parametres_cles_valeurs'), ','), '}'))",
              "runAfter": {
                "Parametres_cles_valeurs": [
                  "Succeeded"
                ]
              }
            },
            "Aujourdhui": {
              "type": "Compose",
              "inputs": "@formatDateTime(convertTimeZone(utcNow(), 'UTC', 'Romance Standard Time'), 'yyyy-MM-dd')",
              "runAfter": {
                "Parametres": [
                  "Succeeded"
                ]
              }
            },
            "Membres_G_RD": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/sitegroups/getbyname('HNCS-RD-EquipeRD')/users?$select=Email",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Aujourdhui": [
                  "Succeeded"
                ]
              }
            },
            "Emails_G_RD": {
              "type": "Select",
              "inputs": {
                "from": "@body('Membres_G_RD')?['value']",
                "select": "@toLower(coalesce(item()?['Email'], ''))"
              },
              "runAfter": {
                "Membres_G_RD": [
                  "Succeeded"
                ]
              }
            },
            "Candidatures_en_attente": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Candidatures",
                  "$filter": "Statut eq 'Reçue' or Statut eq 'À analyser' or Statut eq 'En cours d''analyse'",
                  "$top": 5000
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Emails_G_RD": [
                  "Succeeded"
                ]
              }
            },
            "Candidatures_sans_traitement": {
              "type": "Query",
              "inputs": {
                "from": "@body('Candidatures_en_attente')?['value']",
                "where": "@and(not(empty(coalesce(item()?['DateStatut'], item()?['DateReception']))), less(ticks(coalesce(item()?['DateStatut'], item()?['DateReception'])), ticks(addDays(utcNow(), mul(-1, int(coalesce(outputs('Parametres')?['Delai.RelanceAnalyseJours'], '5')))))))"
              },
              "runAfter": {
                "Candidatures_en_attente": [
                  "Succeeded"
                ]
              }
            },
            "Pour_candidature": {
              "type": "Foreach",
              "foreach": "@body('Candidatures_sans_traitement')",
              "actions": {
                "Dest_N09": {
                  "type": "Select",
                  "inputs": {
                    "from": "@split(concat(coalesce(if(empty(items('Pour_candidature')?['ResponsableAnalyse']?['Email']), join(body('Emails_G_RD'), ';'), items('Pour_candidature')?['ResponsableAnalyse']?['Email']), '')), ';')",
                    "select": "@toLower(trim(item()))"
                  },
                  "runAfter": {}
                },
                "DestOK_N09": {
                  "type": "Query",
                  "inputs": {
                    "from": "@body('Dest_N09')",
                    "where": "@not(empty(item()))"
                  },
                  "runAfter": {
                    "Dest_N09": [
                      "Succeeded"
                    ]
                  }
                },
                "Si_destinataires_N09": {
                  "type": "If",
                  "expression": "@greater(length(body('DestOK_N09')), 0)",
                  "actions": {
                    "Envoyer_N09": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "connectionName": "shared_office365",
                          "operationId": "SharedMailboxSendEmailV2"
                        },
                        "parameters": {
                          "body/MailboxAddress": "@{coalesce(outputs('Parametres')?['Destinataires.BoiteRD'], '')}",
                          "body/To": "@{join(union(body('DestOK_N09'), body('DestOK_N09')), ';')}",
                          "body/Subject": "[HNCS-R&D][N-09] Relance : candidature @{coalesce(items('Pour_candidature')?['IdHNCS'], string(items('Pour_candidature')?['ID']))} sans traitement",
                          "body/Body": "<html>\n<head><meta charset=\"utf-8\"><title>[HNCS-R&amp;D][N-09] Relance : candidature @{coalesce(items('Pour_candidature')?['IdHNCS'], string(items('Pour_candidature')?['ID']))} sans traitement</title></head>\n<body style=\"font-family:'Segoe UI',Arial,sans-serif;font-size:14px;color:#222222\">\n<p>Bonjour,</p>\n<p>La candidature <strong>@{coalesce(items('Pour_candidature')?['IdHNCS'], string(items('Pour_candidature')?['ID']))}</strong> est au statut « @{items('Pour_candidature')?['Statut']?['Value']} » depuis @{string(div(sub(ticks(utcNow()), ticks(coalesce(items('Pour_candidature')?['DateStatut'], items('Pour_candidature')?['DateReception']))), 864000000000))} jours sans traitement.</p>\n<p><a href=\"@{concat(parameters('hncs_SiteUrl (hncs_SiteUrl)'), '/Lists/Candidatures/DispForm.aspx?ID=', string(items('Pour_candidature')?['ID']))}\">Ouvrir la candidature</a></p>\n<p style=\"color:#666666;font-size:12px\">Message automatique du système de suivi R&amp;D HNCS : ne pas répondre. Aucune pièce jointe n'est jamais transmise : les documents sont accessibles par lien, selon vos droits.</p>\n</body>\n</html>",
                          "body/Importance": "Normal"
                        },
                        "authentication": "@parameters('$authentication')",
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 4,
                          "interval": "PT10S"
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {
                      "Sans_destinataire_N09": {
                        "type": "Workflow",
                        "inputs": {
                          "host": {
                            "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                          },
                          "body": {
                            "CodeFlux": "PA-02b",
                            "Niveau": "Avertissement",
                            "Liste": "",
                            "ItemId": "@{string(coalesce('', ''))}",
                            "IdObjet": "@{coalesce('', '')}",
                            "Message": "@{'N-09 : aucun destinataire résolu, notification non envoyée'}",
                            "DetailErreur": "@{string(coalesce('', ''))}",
                            "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                          }
                        },
                        "runAfter": {}
                      }
                    }
                  },
                  "runAfter": {
                    "DestOK_N09": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "runAfter": {
                "Candidatures_sans_traitement": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Erreur": {
          "type": "Scope",
          "actions": {
            "Detail_erreur": {
              "type": "Compose",
              "inputs": "@string(result('Principal'))",
              "runAfter": {}
            },
            "Journaliser_erreur": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                },
                "body": {
                  "CodeFlux": "PA-02b",
                  "Niveau": "Erreur",
                  "Liste": "",
                  "ItemId": "@{string(coalesce('', ''))}",
                  "IdObjet": "@{coalesce('', '')}",
                  "Message": "@{'Échec de l''exécution du flux PA-02b'}",
                  "DetailErreur": "@{string(coalesce(substring(outputs('Detail_erreur'), 0, min(length(outputs('Detail_erreur')), 8000)), ''))}",
                  "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                }
              },
              "runAfter": {
                "Detail_erreur": [
                  "Succeeded"
                ]
              }
            },
            "Terminer_en_echec": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "HNCS_ECHEC",
                  "message": "Échec du flux PA-02b : voir le journal des flux"
                }
              },
              "runAfter": {
                "Journaliser_erreur": [
                  "Succeeded",
                  "Failed",
                  "TimedOut",
                  "Skipped"
                ]
              }
            }
          },
          "runAfter": {
            "Principal": [
              "Failed",
              "TimedOut"
            ]
          }
        },
        "Terminer": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Succeeded"
          },
          "runAfter": {
            "Erreur": [
              "Skipped"
            ]
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
