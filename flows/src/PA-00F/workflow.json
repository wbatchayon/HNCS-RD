{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hncs_sharepoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "hncs_SiteUrl (hncs_SiteUrl)": {
          "defaultValue": "https://contoso.sharepoint.com/sites/HNCS-RD",
          "type": "String",
          "metadata": {
            "schemaName": "hncs_SiteUrl",
            "description": "URL du site SharePoint HNCS-R&D (sans barre finale)"
          }
        },
        "hncs_ServiceAccountEmail (hncs_ServiceAccountEmail)": {
          "defaultValue": "svc-hncs-rd@contoso.com",
          "type": "String",
          "metadata": {
            "schemaName": "hncs_ServiceAccountEmail",
            "description": "Adresse du compte de service des flux (rôle FLUX)"
          }
        }
      },
      "triggers": {
        "Quand_un_element_est_cree_ou_modifie": {
          "type": "OpenApiConnection",
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnUpdatedItems"
            },
            "parameters": {
              "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
              "table": "Registre des modèles R&D"
            },
            "authentication": "@parameters('$authentication')"
          },
          "conditions": [
            {
              "expression": "@not(equals(toLower(triggerOutputs()?['body/Editor/Email']), toLower(parameters('hncs_ServiceAccountEmail (hncs_ServiceAccountEmail)'))))"
            }
          ]
        }
      },
      "actions": {
        "Principal": {
          "type": "Scope",
          "actions": {
            "Lire_parametres": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Paramètres",
                  "$filter": "Categorie eq 'Destinataires' or Categorie eq 'Délais' or Categorie eq 'Fonctionnalités' or Categorie eq 'Conservation' or Categorie eq 'Liens' or Categorie eq 'Gouvernance' or Categorie eq 'Canaux'",
                  "$top": 500
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {}
            },
            "Parametres_cles_valeurs": {
              "type": "Select",
              "inputs": {
                "from": "@body('Lire_parametres')?['value']",
                "select": "@concat('\"', replace(item()?['Title'], '\"', ''), '\":', if(empty(item()?['Valeur']), 'null', concat('\"', replace(replace(item()?['Valeur'], '\\', '\\\\'), '\"', '\\\"'), '\"')))"
              },
              "runAfter": {
                "Lire_parametres": [
                  "Succeeded"
                ]
              }
            },
            "Parametres": {
              "type": "Compose",
              "inputs": "@json(concat('{', join(body('Parametres_cles_valeurs'), ','), '}'))",
              "runAfter": {
                "Parametres_cles_valeurs": [
                  "Succeeded"
                ]
              }
            },
            "Aujourdhui": {
              "type": "Compose",
              "inputs": "@formatDateTime(convertTimeZone(utcNow(), 'UTC', 'Romance Standard Time'), 'yyyy-MM-dd')",
              "runAfter": {
                "Parametres": [
                  "Succeeded"
                ]
              }
            },
            "Niveau_CSS": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/roledefinitions/getbyname('HNCS - Contribution sans suppression')?$select=Id",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Aujourdhui": [
                  "Succeeded"
                ]
              }
            },
            "Lire_element": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItem"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Registre des modèles R&D",
                  "id": "@triggerOutputs()?['body/ID']"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Niveau_CSS": [
                  "Succeeded"
                ]
              }
            },
            "IdObjet_el": {
              "type": "Compose",
              "inputs": "@if(empty(body('Lire_element')?['IdHNCS']), concat('MOD-', formatDateTime(convertTimeZone(body('Lire_element')?['Created'], 'UTC', 'Romance Standard Time'), 'yyyy'), '-', formatNumber(int(body('Lire_element')?['ID']), '0000')), body('Lire_element')?['IdHNCS'])",
              "runAfter": {
                "Lire_element": [
                  "Succeeded"
                ]
              }
            },
            "Si_IdHNCS_vide_el": {
              "type": "If",
              "expression": "@empty(body('Lire_element')?['IdHNCS'])",
              "actions": {
                "Ecrire_IdHNCS_el": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                      "table": "Registre des modèles R&D",
                      "id": "@body('Lire_element')?['ID']",
                      "item/IdHNCS": "@{outputs('IdObjet_el')}",
                      "item/TypeModele/Value": "@{body('Lire_element')?['TypeModele']?['Value']}",
                      "item/Version": "@body('Lire_element')?['Version']",
                      "item/Proprietaire/Claims": "@{body('Lire_element')?['Proprietaire']?['Claims']}",
                      "item/Statut/Value": "@{body('Lire_element')?['Statut']?['Value']}",
                      "item/Title": "@body('Lire_element')?['Title']"
                    },
                    "authentication": "@parameters('$authentication')",
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 4,
                      "interval": "PT10S"
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "IdObjet_el": [
                  "Succeeded"
                ]
              }
            },
            "Changements": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItemChanges"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Registre des modèles R&D",
                  "id": "@body('Lire_element')?['ID']",
                  "since": "@{triggerOutputs()?['body/{TriggerWindowStartToken}']}",
                  "includeDrafts": false
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Si_IdHNCS_vide_el": [
                  "Succeeded"
                ]
              }
            },
            "Si_proprietaire_ou_fichier_modifie": {
              "type": "If",
              "expression": "@and(not(empty(body('Lire_element')?['Proprietaire']?['Email'])), or(not(equals(string(coalesce(body('Changements')?['SinceVersionExisted'], true)), 'True')), equals(string(coalesce(body('Changements')?['ColumnHasChanged']?['Proprietaire'], false)), 'True'), equals(string(coalesce(body('Changements')?['ColumnHasChanged']?['LienFichier'], false)), 'True')))",
              "actions": {
                "Rompre_heritage_modele": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest"
                    },
                    "parameters": {
                      "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                      "parameters/method": "POST",
                      "parameters/uri": "@{concat(concat('_api/web/GetList(''', concat(uriPath(parameters('hncs_SiteUrl (hncs_SiteUrl)')), '/Lists/RegistreModeles'), ''')/items(', string(body('Lire_element')?['ID']), ')'), '/breakroleinheritance(copyRoleAssignments=true,clearSubscopes=true)')}",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata",
                        "Content-Type": "application/json;odata=nometadata"
                      }
                    },
                    "authentication": "@parameters('$authentication')",
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 4,
                      "interval": "PT10S"
                    }
                  },
                  "runAfter": {}
                },
                "Si_utilisateur_modele_1": {
                  "type": "If",
                  "expression": "@not(empty(body('Lire_element')?['Proprietaire']?['Email']))",
                  "actions": {
                    "Utilisateur_modele_1": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "HttpRequest"
                        },
                        "parameters": {
                          "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                          "parameters/method": "POST",
                          "parameters/uri": "_api/web/ensureuser",
                          "parameters/headers": {
                            "Accept": "application/json;odata=nometadata",
                            "Content-Type": "application/json;odata=nometadata"
                          },
                          "parameters/body": "@{concat('{\"logonName\":\"i:0#.f|membership|', toLower(body('Lire_element')?['Proprietaire']?['Email']), '\"}')}"
                        },
                        "authentication": "@parameters('$authentication')",
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 4,
                          "interval": "PT10S"
                        }
                      },
                      "runAfter": {}
                    },
                    "Attribuer_modele_U1_CSS": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "HttpRequest"
                        },
                        "parameters": {
                          "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                          "parameters/method": "POST",
                          "parameters/uri": "@{concat(concat('_api/web/GetList(''', concat(uriPath(parameters('hncs_SiteUrl (hncs_SiteUrl)')), '/Lists/RegistreModeles'), ''')/items(', string(body('Lire_element')?['ID']), ')'), '/roleassignments/addroleassignment(principalid=', string(body('Utilisateur_modele_1')?['Id']), ',roledefid=', string(body('Niveau_CSS')?['Id']), ')')}",
                          "parameters/headers": {
                            "Accept": "application/json;odata=nometadata",
                            "Content-Type": "application/json;odata=nometadata"
                          }
                        },
                        "authentication": "@parameters('$authentication')",
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 4,
                          "interval": "PT10S"
                        }
                      },
                      "runAfter": {
                        "Utilisateur_modele_1": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "Rompre_heritage_modele": [
                      "Succeeded"
                    ]
                  }
                },
                "Fichiers_du_modele": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "GetFileItems"
                    },
                    "parameters": {
                      "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                      "table": "03 — Modèles R&D",
                      "$filter": "ModeleId eq @{body('Lire_element')?['ID']}",
                      "$top": 5000
                    },
                    "authentication": "@parameters('$authentication')",
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 4,
                      "interval": "PT10S"
                    }
                  },
                  "runAfter": {
                    "Si_utilisateur_modele_1": [
                      "Succeeded"
                    ]
                  }
                },
                "Pour_fichier": {
                  "type": "Foreach",
                  "foreach": "@body('Fichiers_du_modele')?['value']",
                  "actions": {
                    "Rompre_heritage_fichier_modele": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "HttpRequest"
                        },
                        "parameters": {
                          "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                          "parameters/method": "POST",
                          "parameters/uri": "@{concat(concat('_api/web/GetList(''', concat(uriPath(parameters('hncs_SiteUrl (hncs_SiteUrl)')), '/ModelesRD'), ''')/items(', string(items('Pour_fichier')?['ID']), ')'), '/breakroleinheritance(copyRoleAssignments=true,clearSubscopes=true)')}",
                          "parameters/headers": {
                            "Accept": "application/json;odata=nometadata",
                            "Content-Type": "application/json;odata=nometadata"
                          }
                        },
                        "authentication": "@parameters('$authentication')",
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 4,
                          "interval": "PT10S"
                        }
                      },
                      "runAfter": {}
                    },
                    "Si_utilisateur_fichier_modele_1": {
                      "type": "If",
                      "expression": "@not(empty(body('Lire_element')?['Proprietaire']?['Email']))",
                      "actions": {
                        "Utilisateur_fichier_modele_1": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "connectionName": "shared_sharepointonline",
                              "operationId": "HttpRequest"
                            },
                            "parameters": {
                              "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                              "parameters/method": "POST",
                              "parameters/uri": "_api/web/ensureuser",
                              "parameters/headers": {
                                "Accept": "application/json;odata=nometadata",
                                "Content-Type": "application/json;odata=nometadata"
                              },
                              "parameters/body": "@{concat('{\"logonName\":\"i:0#.f|membership|', toLower(body('Lire_element')?['Proprietaire']?['Email']), '\"}')}"
                            },
                            "authentication": "@parameters('$authentication')",
                            "retryPolicy": {
                              "type": "exponential",
                              "count": 4,
                              "interval": "PT10S"
                            }
                          },
                          "runAfter": {}
                        },
                        "Attribuer_fichier_modele_U1_CSS": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "connectionName": "shared_sharepointonline",
                              "operationId": "HttpRequest"
                            },
                            "parameters": {
                              "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                              "parameters/method": "POST",
                              "parameters/uri": "@{concat(concat('_api/web/GetList(''', concat(uriPath(parameters('hncs_SiteUrl (hncs_SiteUrl)')), '/ModelesRD'), ''')/items(', string(items('Pour_fichier')?['ID']), ')'), '/roleassignments/addroleassignment(principalid=', string(body('Utilisateur_fichier_modele_1')?['Id']), ',roledefid=', string(body('Niveau_CSS')?['Id']), ')')}",
                              "parameters/headers": {
                                "Accept": "application/json;odata=nometadata",
                                "Content-Type": "application/json;odata=nometadata"
                              }
                            },
                            "authentication": "@parameters('$authentication')",
                            "retryPolicy": {
                              "type": "exponential",
                              "count": 4,
                              "interval": "PT10S"
                            }
                          },
                          "runAfter": {
                            "Utilisateur_fichier_modele_1": [
                              "Succeeded"
                            ]
                          }
                        }
                      },
                      "else": {
                        "actions": {}
                      },
                      "runAfter": {
                        "Rompre_heritage_fichier_modele": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 1
                    }
                  },
                  "runAfter": {
                    "Fichiers_du_modele": [
                      "Succeeded"
                    ]
                  }
                },
                "Journaliser_droits_modele": {
                  "type": "Workflow",
                  "inputs": {
                    "host": {
                      "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                    },
                    "body": {
                      "CodeFlux": "PA-00F",
                      "Niveau": "Info",
                      "Liste": "RegistreModeles",
                      "ItemId": "@{string(coalesce(body('Lire_element')?['ID'], ''))}",
                      "IdObjet": "@{coalesce(outputs('IdObjet_el'), '')}",
                      "Message": "@{concat('Droits du propriétaire posés sur ', outputs('IdObjet_el'))}",
                      "DetailErreur": "@{string(coalesce('', ''))}",
                      "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                    }
                  },
                  "runAfter": {
                    "Pour_fichier": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Changements": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Erreur": {
          "type": "Scope",
          "actions": {
            "Detail_erreur": {
              "type": "Compose",
              "inputs": "@string(result('Principal'))",
              "runAfter": {}
            },
            "Journaliser_erreur": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                },
                "body": {
                  "CodeFlux": "PA-00F",
                  "Niveau": "Erreur",
                  "Liste": "RegistreModeles",
                  "ItemId": "@{string(coalesce(triggerOutputs()?['body/ID'], ''))}",
                  "IdObjet": "@{coalesce(triggerOutputs()?['body/IdHNCS'], '')}",
                  "Message": "@{'Échec de l''exécution du flux PA-00F'}",
                  "DetailErreur": "@{string(coalesce(substring(outputs('Detail_erreur'), 0, min(length(outputs('Detail_erreur')), 8000)), ''))}",
                  "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                }
              },
              "runAfter": {
                "Detail_erreur": [
                  "Succeeded"
                ]
              }
            },
            "Terminer_en_echec": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "HNCS_ECHEC",
                  "message": "Échec du flux PA-00F : voir le journal des flux"
                }
              },
              "runAfter": {
                "Journaliser_erreur": [
                  "Succeeded",
                  "Failed",
                  "TimedOut",
                  "Skipped"
                ]
              }
            }
          },
          "runAfter": {
            "Principal": [
              "Failed",
              "TimedOut"
            ]
          }
        },
        "Terminer": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Succeeded"
          },
          "runAfter": {
            "Erreur": [
              "Skipped"
            ]
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
