{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hncs_outlook"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hncs_sharepoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_teams": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hncs_teams"
        },
        "api": {
          "name": "shared_teams"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "hncs_SiteUrl (hncs_SiteUrl)": {
          "defaultValue": "https://contoso.sharepoint.com/sites/HNCS-RD",
          "type": "String",
          "metadata": {
            "schemaName": "hncs_SiteUrl",
            "description": "URL du site SharePoint HNCS-R&D (sans barre finale)"
          }
        },
        "hncs_ServiceAccountEmail (hncs_ServiceAccountEmail)": {
          "defaultValue": "svc-hncs-rd@contoso.com",
          "type": "String",
          "metadata": {
            "schemaName": "hncs_ServiceAccountEmail",
            "description": "Adresse du compte de service des flux (rôle FLUX)"
          }
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "schedule": {
              "hours": [
                "7"
              ],
              "minutes": [
                10
              ]
            },
            "timeZone": "Romance Standard Time"
          }
        }
      },
      "actions": {
        "Principal": {
          "type": "Scope",
          "actions": {
            "Lire_parametres": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Paramètres",
                  "$filter": "Categorie eq 'Destinataires' or Categorie eq 'Délais' or Categorie eq 'Fonctionnalités' or Categorie eq 'Conservation' or Categorie eq 'Liens' or Categorie eq 'Gouvernance' or Categorie eq 'Canaux'",
                  "$top": 500
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {}
            },
            "Parametres_cles_valeurs": {
              "type": "Select",
              "inputs": {
                "from": "@body('Lire_parametres')?['value']",
                "select": "@concat('\"', replace(item()?['Title'], '\"', ''), '\":', if(empty(item()?['Valeur']), 'null', concat('\"', replace(replace(item()?['Valeur'], '\\', '\\\\'), '\"', '\\\"'), '\"')))"
              },
              "runAfter": {
                "Lire_parametres": [
                  "Succeeded"
                ]
              }
            },
            "Parametres": {
              "type": "Compose",
              "inputs": "@json(concat('{', join(body('Parametres_cles_valeurs'), ','), '}'))",
              "runAfter": {
                "Parametres_cles_valeurs": [
                  "Succeeded"
                ]
              }
            },
            "Aujourdhui": {
              "type": "Compose",
              "inputs": "@formatDateTime(convertTimeZone(utcNow(), 'UTC', 'Romance Standard Time'), 'yyyy-MM-dd')",
              "runAfter": {
                "Parametres": [
                  "Succeeded"
                ]
              }
            },
            "Membres_G_ECO": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/sitegroups/getbyname('HNCS-RD-RelationEcoles')/users?$select=Email",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Aujourdhui": [
                  "Succeeded"
                ]
              }
            },
            "Emails_G_ECO": {
              "type": "Select",
              "inputs": {
                "from": "@body('Membres_G_ECO')?['value']",
                "select": "@toLower(coalesce(item()?['Email'], ''))"
              },
              "runAfter": {
                "Membres_G_ECO": [
                  "Succeeded"
                ]
              }
            },
            "Conventions_actives": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                  "table": "Conventions et partenariats",
                  "$filter": "Statut eq 'Signée / active' or Statut eq 'À renouveler'",
                  "$top": 5000
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "exponential",
                  "count": 4,
                  "interval": "PT10S"
                }
              },
              "runAfter": {
                "Emails_G_ECO": [
                  "Succeeded"
                ]
              }
            },
            "Conventions_expirees": {
              "type": "Query",
              "inputs": {
                "from": "@body('Conventions_actives')?['value']",
                "where": "@and(not(empty(item()?['DateFin'])), less(if(empty(item()?['DateFin']), '', formatDateTime(convertTimeZone(item()?['DateFin'], 'UTC', 'Romance Standard Time'), 'yyyy-MM-dd')), outputs('Aujourdhui')))"
              },
              "runAfter": {
                "Conventions_actives": [
                  "Succeeded"
                ]
              }
            },
            "Conventions_a_renouveler": {
              "type": "Query",
              "inputs": {
                "from": "@body('Conventions_actives')?['value']",
                "where": "@and(equals(item()?['Statut']?['Value'], 'Signée / active'), not(empty(item()?['DateFin'])), greaterOrEquals(if(empty(item()?['DateFin']), '', formatDateTime(convertTimeZone(item()?['DateFin'], 'UTC', 'Romance Standard Time'), 'yyyy-MM-dd')), outputs('Aujourdhui')), lessOrEquals(if(empty(item()?['DateFin']), '', formatDateTime(convertTimeZone(item()?['DateFin'], 'UTC', 'Romance Standard Time'), 'yyyy-MM-dd')), addDays(outputs('Aujourdhui'), int(coalesce(outputs('Parametres')?['Convention.AlerteExpirationJours'], '60')), 'yyyy-MM-dd')))"
              },
              "runAfter": {
                "Conventions_expirees": [
                  "Succeeded"
                ]
              }
            },
            "Pour_convention_expiree": {
              "type": "Foreach",
              "foreach": "@body('Conventions_expirees')",
              "actions": {
                "Verifier_CONV_T05": {
                  "type": "Workflow",
                  "inputs": {
                    "host": {
                      "workflowReferenceName": "fa7991cb-62cf-5740-a458-f1a6db5ab0eb"
                    },
                    "body": {
                      "Objet": "Convention",
                      "StatutAvant": "@{items('Pour_convention_expiree')?['Statut']?['Value']}",
                      "StatutApres": "@{'Expirée'}",
                      "ActeurEmail": "@{parameters('hncs_ServiceAccountEmail (hncs_ServiceAccountEmail)')}",
                      "ItemAuteurEmail": "@{coalesce('', '')}",
                      "ItemValideurEmail": "@{coalesce('', '')}"
                    }
                  },
                  "runAfter": {}
                },
                "Controles_CONV_T05": {
                  "type": "Compose",
                  "inputs": "@split(replace(coalesce(body('Verifier_CONV_T05')?['Controles'], ''), ' ', ''), ';')",
                  "runAfter": {
                    "Verifier_CONV_T05": [
                      "Succeeded"
                    ]
                  }
                },
                "Controles_inconnus_CONV_T05": {
                  "type": "Query",
                  "inputs": {
                    "from": "@outputs('Controles_CONV_T05')",
                    "where": "@and(not(empty(item())), not(contains(createArray('G_DATE_FIN_DEPASSEE'), item())))"
                  },
                  "runAfter": {
                    "Controles_CONV_T05": [
                      "Succeeded"
                    ]
                  }
                },
                "Controles_echec_CONV_T05": {
                  "type": "Query",
                  "inputs": {
                    "from": "@createArray(if(and(contains(outputs('Controles_CONV_T05'), 'G_DATE_FIN_DEPASSEE'), not(or(not(true), and(not(empty(items('Pour_convention_expiree')?['DateFin'])), less(if(empty(items('Pour_convention_expiree')?['DateFin']), '', formatDateTime(convertTimeZone(items('Pour_convention_expiree')?['DateFin'], 'UTC', 'Romance Standard Time'), 'yyyy-MM-dd')), outputs('Aujourdhui')))))), 'G_DATE_FIN_DEPASSEE (DateFin < aujourd''hui (non exigé pour une action humaine))', ''))",
                    "where": "@not(empty(item()))"
                  },
                  "runAfter": {
                    "Controles_inconnus_CONV_T05": [
                      "Succeeded"
                    ]
                  }
                },
                "Si_CONV_T05_autorisee": {
                  "type": "If",
                  "expression": "@and(equals(toLower(string(coalesce(body('Verifier_CONV_T05')?['Autorise'], false))), 'true'), and(empty(body('Controles_echec_CONV_T05')), empty(body('Controles_inconnus_CONV_T05'))))",
                  "actions": {
                    "Statut_CONV_T05": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PatchItem"
                        },
                        "parameters": {
                          "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                          "table": "Conventions et partenariats",
                          "id": "@items('Pour_convention_expiree')?['ID']",
                          "item/Statut/Value": "Expirée",
                          "item/Etablissement/Id": "@items('Pour_convention_expiree')?['Etablissement']?['Id']",
                          "item/TypeConvention/Value": "@{items('Pour_convention_expiree')?['TypeConvention']?['Value']}",
                          "item/Title": "@items('Pour_convention_expiree')?['Title']"
                        },
                        "authentication": "@parameters('$authentication')",
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 4,
                          "interval": "PT10S"
                        }
                      },
                      "runAfter": {}
                    },
                    "Historiser_CONV_T05": {
                      "type": "Workflow",
                      "inputs": {
                        "host": {
                          "workflowReferenceName": "d12115ea-8f45-524c-b8b1-f7a45e1e278d"
                        },
                        "body": {
                          "Liste": "Conventions",
                          "ItemId": "@int(items('Pour_convention_expiree')?['ID'])",
                          "IdObjet": "@{coalesce(items('Pour_convention_expiree')?['IdHNCS'], string(items('Pour_convention_expiree')?['ID']))}",
                          "Objet": "Convention",
                          "StatutAvant": "@{items('Pour_convention_expiree')?['Statut']?['Value']}",
                          "StatutApres": "@{'Expirée'}",
                          "Accepte": "@true",
                          "CodeTransition": "@{coalesce(body('Verifier_CONV_T05')?['CodeTransition'], '')}",
                          "ActeurEmail": "@{parameters('hncs_ServiceAccountEmail (hncs_ServiceAccountEmail)')}",
                          "Origine": "Flux",
                          "Motif": "@{coalesce('', '')}",
                          "RunId": "@{workflow()?['run']?['name']}"
                        }
                      },
                      "runAfter": {
                        "Statut_CONV_T05": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Dest_N40": {
                      "type": "Select",
                      "inputs": {
                        "from": "@split(concat(coalesce(items('Pour_convention_expiree')?['Responsable']?['Email'], ''), ';', coalesce(join(body('Emails_G_ECO'), ';'), '')), ';')",
                        "select": "@toLower(trim(item()))"
                      },
                      "runAfter": {
                        "Historiser_CONV_T05": [
                          "Succeeded"
                        ]
                      }
                    },
                    "DestOK_N40": {
                      "type": "Query",
                      "inputs": {
                        "from": "@body('Dest_N40')",
                        "where": "@not(empty(item()))"
                      },
                      "runAfter": {
                        "Dest_N40": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Si_destinataires_N40": {
                      "type": "If",
                      "expression": "@greater(length(body('DestOK_N40')), 0)",
                      "actions": {
                        "Envoyer_N40": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                              "connectionName": "shared_office365",
                              "operationId": "SharedMailboxSendEmailV2"
                            },
                            "parameters": {
                              "body/MailboxAddress": "@{coalesce(outputs('Parametres')?['Destinataires.BoiteRD'], '')}",
                              "body/To": "@{join(union(body('DestOK_N40'), body('DestOK_N40')), ';')}",
                              "body/Subject": "[HNCS-R&D][N-40] Convention @{coalesce(items('Pour_convention_expiree')?['IdHNCS'], string(items('Pour_convention_expiree')?['ID']))} @{'Expirée'}",
                              "body/Body": "<html>\n<head><meta charset=\"utf-8\"><title>[HNCS-R&amp;D][N-40] Convention @{coalesce(items('Pour_convention_expiree')?['IdHNCS'], string(items('Pour_convention_expiree')?['ID']))} @{'Expirée'}</title></head>\n<body style=\"font-family:'Segoe UI',Arial,sans-serif;font-size:14px;color:#222222\">\n<p>Bonjour,</p>\n<p>La convention <strong>@{coalesce(items('Pour_convention_expiree')?['IdHNCS'], string(items('Pour_convention_expiree')?['ID']))}</strong> est passée au statut <strong>@{'Expirée'}</strong>.</p>\n<ul><li>Date de fin : @{if(empty(items('Pour_convention_expiree')?['DateFin']), '', formatDateTime(convertTimeZone(items('Pour_convention_expiree')?['DateFin'], 'UTC', 'Romance Standard Time'), 'dd/MM/yyyy'))}</li><li>Renouvellement : @{coalesce(items('Pour_convention_expiree')?['Renouvellement']?['Value'], '—')}</li></ul>\n<p><a href=\"@{concat(parameters('hncs_SiteUrl (hncs_SiteUrl)'), '/Lists/Conventions/DispForm.aspx?ID=', string(items('Pour_convention_expiree')?['ID']))}\">Ouvrir la convention</a></p>\n<p style=\"color:#666666;font-size:12px\">Message automatique du système de suivi R&amp;D HNCS — ne pas répondre. Aucune pièce jointe n'est jamais transmise : les documents sont accessibles par lien, selon vos droits.</p>\n</body>\n</html>",
                              "body/Importance": "Normal"
                            },
                            "authentication": "@parameters('$authentication')",
                            "retryPolicy": {
                              "type": "exponential",
                              "count": 4,
                              "interval": "PT10S"
                            }
                          },
                          "runAfter": {}
                        }
                      },
                      "else": {
                        "actions": {
                          "Sans_destinataire_N40": {
                            "type": "Workflow",
                            "inputs": {
                              "host": {
                                "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                              },
                              "body": {
                                "CodeFlux": "PA-10b",
                                "Niveau": "Avertissement",
                                "Liste": "",
                                "ItemId": "@{string(coalesce('', ''))}",
                                "IdObjet": "@{coalesce('', '')}",
                                "Message": "@{'N-40 : aucun destinataire résolu, notification non envoyée'}",
                                "DetailErreur": "@{string(coalesce('', ''))}",
                                "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                              }
                            },
                            "runAfter": {}
                          }
                        }
                      },
                      "runAfter": {
                        "DestOK_N40": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Transition_non_appliquee_CONV_T05": {
                        "type": "Workflow",
                        "inputs": {
                          "host": {
                            "workflowReferenceName": "8f895e3b-a283-5633-abec-4f84f6a2eac8"
                          },
                          "body": {
                            "CodeFlux": "PA-10b",
                            "Niveau": "Avertissement",
                            "Liste": "Conventions",
                            "ItemId": "@{string(coalesce(items('Pour_convention_expiree')?['ID'], ''))}",
                            "IdObjet": "@{coalesce(coalesce(items('Pour_convention_expiree')?['IdHNCS'], string(items('Pour_convention_expiree')?['ID'])), '')}",
                            "Message": "@{concat('CONV-T05 (FLUX) non appliquée : ', if(equals(toLower(string(coalesce(body('Verifier_CONV_T05')?['Autorise'], false))), 'true'), concat('Contrôle(s) non satisfait(s) : ', join(union(body('Controles_echec_CONV_T05'), body('Controles_inconnus_CONV_T05')), ' ; ')), coalesce(body('Verifier_CONV_T05')?['Motif'], '')))}",
                            "DetailErreur": "@{string(coalesce('', ''))}",
                            "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                          }
                        },
                        "runAfter": {}
                      }
                    }
                  },
                  "runAfter": {
                    "Controles_echec_CONV_T05": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "runAfter": {
                "Conventions_a_renouveler": [
                  "Succeeded"
                ]
              }
            },
            "Pour_convention_a_renouveler": {
              "type": "Foreach",
              "foreach": "@body('Conventions_a_renouveler')",
              "actions": {
                "Verifier_CONV_T04": {
                  "type": "Workflow",
                  "inputs": {
                    "host": {
                      "workflowReferenceName": "fa7991cb-62cf-5740-a458-f1a6db5ab0eb"
                    },
                    "body": {
                      "Objet": "Convention",
                      "StatutAvant": "@{items('Pour_convention_a_renouveler')?['Statut']?['Value']}",
                      "StatutApres": "@{'À renouveler'}",
                      "ActeurEmail": "@{parameters('hncs_ServiceAccountEmail (hncs_ServiceAccountEmail)')}",
                      "ItemAuteurEmail": "@{coalesce('', '')}",
                      "ItemValideurEmail": "@{coalesce('', '')}"
                    }
                  },
                  "runAfter": {}
                },
                "Controles_CONV_T04": {
                  "type": "Compose",
                  "inputs": "@split(replace(coalesce(body('Verifier_CONV_T04')?['Controles'], ''), ' ', ''), ';')",
                  "runAfter": {
                    "Verifier_CONV_T04": [
                      "Succeeded"
                    ]
                  }
                },
                "Controles_inconnus_CONV_T04": {
                  "type": "Query",
                  "inputs": {
                    "from": "@outputs('Controles_CONV_T04')",
                    "where": "@and(not(empty(item())), not(contains(createArray(), item())))"
                  },
                  "runAfter": {
                    "Controles_CONV_T04": [
                      "Succeeded"
                    ]
                  }
                },
                "Controles_echec_CONV_T04": {
                  "type": "Query",
                  "inputs": {
                    "from": "@createArray()",
                    "where": "@not(empty(item()))"
                  },
                  "runAfter": {
                    "Controles_inconnus_CONV_T04": [
                      "Succeeded"
                    ]
                  }
                },
                "Si_CONV_T04_autorisee": {
                  "type": "If",
                  "expression": "@and(equals(toLower(string(coalesce(body('Verifier_CONV_T04')?['Autorise'], false))), 'true'), and(empty(body('Controles_echec_CONV_T04')), empty(body('Controles_inconnus_CONV_T04'))))",
                  "actions": {
                    "Statut_CONV_T04": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PatchItem"
                        },
                        "parameters": {
                          "dataset": "@parameters('hncs_SiteUrl (hncs_SiteUrl)')",
                          "table": "Conventions et partenariats",
                          "id": "@items('Pour_convention_a_renouveler')?['ID']",
                          "item/Statut/Value": "À renouveler",
                          "item/Etablissement/Id": "@items('Pour_convention_a_renouveler')?['Etablissement']?['Id']",
                          "item/TypeConvention/Value": "@{items('Pour_convention_a_renouveler')?['TypeConvention']?['Value']}",
                          "item/Title": "@items('Pour_convention_a_renouveler')?['Title']"
                        },
                        "authentication": "@parameters('$authentication')",
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 4,
                          "interval": "PT10S"
                        }
                      },
                      "runAfter": {}
                    },
                    "Historiser_CONV_T04": {
                      "type": "Workflow",
                      "inputs": {
                        "host": {
                          "workflowReferenceName": "d12115ea-8f45-524c-b8b1-f7a45e1e278d"
                        },
                        "body": {
                          "Liste": "Conventions",
                          "ItemId": "@int(items('Pour_convention_a_renouveler')?['ID'])",
                          "IdObjet": "@{coalesce(items('Pour_convention_a_renouveler')?['IdHNCS'], string(items('Pour_convention_a_renouveler')?['ID']))}",
                          "Objet": "Convention",
                          "StatutAvant": "@{items('Pour_convention_a_renouveler')?['Statut']?['Value']}",
                          "StatutApres": "@{'À renouveler'}",
                          "Accepte": "@true",
                          "CodeTransition": "@{coalesce(body('Verifier_CONV_T04')?['CodeTransition'], '')}",
                          "ActeurEmail": "@{parameters('hncs_ServiceAccountEmail (hncs_ServiceAccountEmail)')}",
                          "Origine": "Flux",
                          "Motif": "@{coalesce('', '')}",
                          "RunId": "@{workflow()?['run']?['name']}"
                        }
                      },
                      "runAfter": {
                        "Statut_CONV_T04": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Dest_N40_2": {
                      "type": "Select",
                      "inputs": {
                        "from": "@split(concat(coalesce(items('Pour_convention_a_renouveler')?['Responsable']?['Email'], ''), ';', coalesce(join(body('Emails_G_ECO'), ';'), '')), ';')",
                        "select": "@toLower(trim(item()))"
                      },
                      "runAfter": {
                        "Historiser_CONV_T04": [
                          "Succeeded"
                        ]
                      }
                    },
                    "DestOK_N40_2": {
                      "type": "Query",
                      "inputs": {
